@model IEnumerable<SoftflipSolutions.Models.EmployeeDocument>
@{
    ViewData["Title"] = "My Documents";
    Layout = "_EmployeeLayout";
}

<div class="glass-card p-0 overflow-hidden">
    <div class="p-4 border-bottom">
        <h4 class="mb-1">My Documents</h4>
        <p class="mb-0 small text-muted">Offer letters and HR documents generated by Softflip</p>
    </div>
    <div class="table-responsive">
        <table class="table mb-0 align-middle">
            <thead>
                <tr>
                    <th>Document</th>
                    <th>Type</th>
                    <th>Date</th>
                    <th class="text-end">Download</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var d in Model)
                {
                    <tr>
                        <td>
                            <i class="bi bi-file-earmark-pdf text-danger me-1"></i>
                            <strong>@d.Title</strong>
                        </td>
                        <td>@d.DocumentType</td>
                        <td class="small">@d.GeneratedAt.ToString("dd MMM yyyy")</td>
                        <td class="text-end">
                            <a asp-action="DownloadDocument" asp-route-id="@d.Id" class="btn btn-sm btn-outline-info rounded-pill">
                                <i class="bi bi-download"></i> Download
                            </a>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="4" class="text-center text-muted py-5">No documents yet.</td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>
