@model SoftflipSolutions.ViewModels.LeadFollowUpsPanelViewModel
@using SoftflipSolutions.Models
@{
    var defaultDue = DateTime.Today.AddDays(1).AddHours(10);
}

<div class="cp-card mb-4">
    <div class="cp-card-head">
        <div>
            <h5><i class="bi bi-alarm me-2"></i>Follow-up timeline</h5>
            <p>Requirement → Quotation → Demo → Notes — with date &amp; time</p>
        </div>
    </div>
    <div class="cp-card-body p-4">
        <form asp-action="AddFollowUp" asp-controller="Partner" method="post" class="row g-2 align-items-end mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="leadId" value="@Model.LeadId" />
            <div class="col-md-3">
                <label class="form-label settings-label mb-1">Step</label>
                <select name="stepType" class="form-select settings-input" required>
                    @foreach (var s in FollowUpSteps.All)
                    {
                        <option value="@s.Key" title="@s.Hint">@s.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label settings-label mb-1">Due date &amp; time</label>
                <input type="datetime-local" name="dueAt" class="form-control settings-input" value="@defaultDue.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
            <div class="col-md-4">
                <label class="form-label settings-label mb-1">Details / notes</label>
                <input type="text" name="note" class="form-control settings-input" maxlength="500" placeholder="e.g. Send quotation for CRM…" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-crm-primary w-100"><i class="bi bi-alarm me-1"></i> Add</button>
            </div>
        </form>

        <div class="fu-step-hints mb-3">
            @foreach (var s in FollowUpSteps.All.Take(4))
            {
                <span class="fu-step-hint"><i class="bi @s.Icon"></i> @s.Label</span>
            }
            <span class="fu-step-hint text-muted">+ notes &amp; more</span>
        </div>

        @{
            ViewData["FollowUpShowActions"] = true;
            ViewData["FollowUpCompleteAction"] = "CompleteFollowUp";
            ViewData["FollowUpCompleteController"] = "Partner";
        }
        <partial name="_FollowUpTimeline" model="Model.Items" />
    </div>
</div>
