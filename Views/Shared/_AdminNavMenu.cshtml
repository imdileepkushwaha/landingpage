                    "Settings", "MessageTemplates", "AddMessageTemplate", "EditMessageTemplate",
                    "AdminUsers", "AuditLogs", "Notifications", "EmailLogs", "DataExport", "WhatsAppSettings"
                };

                var crmOpen = IsAny(crmActions);
                var partnerOpen = IsAny(partnerActions);
                var salesOpen = IsAny(salesActions);
                var billingOpen = IsAny(billingActions);
