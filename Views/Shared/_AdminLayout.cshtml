<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>@ViewData["Title"] - Softflip OS</title>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css" />
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/bootstrap-icons/1.11.3/font/bootstrap-icons.min.css">
    <link rel="stylesheet" href="~/admin/css/admin-style.css" asp-append-version="true" />
</head>
<body class="admin-body">

    <div class="sidebar-backdrop" id="sidebarBackdrop" onclick="toggleSidebar()"></div>

    <aside class="sidebar" id="adminSidebar">
        <div class="sidebar-header">
            <a class="header-brand" asp-action="Index" asp-controller="Admin">
                <div class="logo-icon-wrapper">
                    <img src="~/admin/img/softflip-logo.png" alt="Softflip" />
                </div>
                <div class="logo-text-admin">Soft<span>flip</span></div>
            </a>
            <button type="button" class="header-toggle d-none d-lg-inline-flex" onclick="toggleSidebar()" aria-label="Collapse sidebar">
                <i class="bi bi-chevron-left"></i>
            </button>
        </div>
        <partial name="_AdminNavMenu" />
        <div class="sidebar-footer">
            <a asp-action="Logout" asp-controller="Admin" class="sidebar-logout" title="Sign out">
                <span class="sidebar-logout-ico"><i class="bi bi-box-arrow-right"></i></span>
                <span class="sidebar-logout-text">
                    <strong>Sign out</strong>
                    <small>End admin session</small>
                </span>
            </a>
        </div>
    </aside>

    <div class="main-content">
        <header class="top-header">
            <button type="button" class="header-toggle mobile-toggle" onclick="toggleSidebar()" aria-label="Toggle menu">
                <i class="bi bi-list"></i>
            </button>

            <div class="header-search" id="headerSearchWrap">
                <form asp-action="Search" asp-controller="Admin" method="get" autocomplete="off">
                    <i class="bi bi-search header-search-icon"></i>
                    <input type="search" name="q" id="headerSearch" placeholder="Search leads, invoices…" aria-label="Search" />
                </form>
                <div class="header-search-results" id="headerSearchResults" hidden></div>
            </div>

            <div class="header-actions">
                <button type="button" class="header-icon-btn" title="Fullscreen" onclick="toggleFullscreen()">
                    <i class="bi bi-arrows-fullscreen"></i>
                </button>
                <!-- <button type="button" class="header-icon-btn" title="Theme">
                    <i class="bi bi-moon"></i>
                </button> -->
                <span class="header-divider" aria-hidden="true"></span>
                @await Component.InvokeAsync("HeaderAlerts")
                <div class="header-dropdown user-profile" data-panel="account">
                    <button type="button" class="user-avatar-btn header-menu-trigger" id="btnUserMenu" title="Account" aria-expanded="false" aria-controls="panelUserMenu">
                        <span class="user-avatar-wrap">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=cceef9&color=0077a3&bold=true&size=72" alt="Admin">
                            <span class="status-dot"></span>
                        </span>
                    </button>
                    <div class="header-panel user-menu-panel" id="panelUserMenu" hidden>
                        <div class="user-menu-head">
                            <img src="https://ui-avatars.com/api/?name=Admin&background=cceef9&color=0077a3&bold=true&size=72" alt="">
                            <div>
                                <strong>@(User.Identity?.Name ?? "Admin")</strong>
                                <small>Administrator</small>
                            </div>
                        </div>
                        <div class="user-menu-list">
                            <a class="user-menu-item" asp-action="Index" asp-controller="Admin">
                                <i class="bi bi-grid"></i> Dashboard
                            </a>
                            <a class="user-menu-item" asp-action="Settings" asp-controller="Admin">
                                <i class="bi bi-gear"></i> Settings
                            </a>
                            <a class="user-menu-item" asp-action="ConfirmedClients" asp-controller="Admin">
                                <i class="bi bi-kanban"></i> Active Deals
                            </a>
                        </div>
                        <div class="user-menu-foot">
                            <a class="user-menu-item danger" asp-action="Logout" asp-controller="Admin">
                                <i class="bi bi-box-arrow-right"></i> Sign out
                            </a>
                        </div>
                    </div>
                </div>
            </div>
        </header>

        <main class="content-body">
            @if (ViewContext.RouteData.Values["Action"]?.ToString() != "Index")
            {
                <partial name="_PageHero" />
            }
            @RenderBody()
        </main>

        <footer class="admin-footer">
            <div>Copyright &copy; @DateTime.Now.Year <span class="brand-accent">Softflip</span></div>
            <div>
                <a href="#">About</a>
                <a href="#">Terms</a>
                <a href="#">Contact Us</a>
            </div>
        </footer>
    </div>

    <script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
    <script>
        function toggleSidebar() {
            document.body.classList.toggle('sidebar-collapsed');
            document.getElementById('adminSidebar').classList.toggle('show');
            document.getElementById('sidebarBackdrop').classList.toggle('show');
        }
        function toggleFullscreen() {
            if (!document.fullscreenElement) {
                document.documentElement.requestFullscreen?.();
            } else {
                document.exitFullscreen?.();
            }
        }

        (function initHeaderAlerts() {
            const storageKey = 'softflip.header.seen';
            const readSeen = () => {
                try { return JSON.parse(localStorage.getItem(storageKey) || '{}'); }
                catch { return {}; }
            };
            const writeSeen = (data) => localStorage.setItem(storageKey, JSON.stringify(data));

            const closeAll = () => {
                document.querySelectorAll('.header-panel').forEach(p => { p.hidden = true; });
                document.querySelectorAll('.header-menu-trigger[aria-expanded], .header-icon-btn[aria-expanded]').forEach(b => b.setAttribute('aria-expanded', 'false'));
            };

            document.querySelectorAll('.header-dropdown').forEach(drop => {
                const btn = drop.querySelector('.header-menu-trigger, .header-icon-btn');
                const panel = drop.querySelector('.header-panel');
                if (!btn || !panel) return;

                btn.addEventListener('click', (e) => {
                    e.stopPropagation();
                    const open = panel.hidden;
                    closeAll();
                    if (open) {
                        panel.hidden = false;
                        btn.setAttribute('aria-expanded', 'true');
                    }
                });
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('.header-dropdown')) closeAll();
            });
            document.addEventListener('keydown', (e) => {
                if (e.key === 'Escape') closeAll();
            });

            const applySeenState = () => {
                const seen = readSeen();
                ['notifications', 'messages'].forEach(kind => {
                    const drop = document.querySelector(`.header-dropdown[data-panel="${kind}"]`);
                    if (!drop) return;
                    const badge = drop.querySelector('.header-badge');
                    const items = [...drop.querySelectorAll('.header-panel-item')];
                    let unread = 0;
                    items.forEach(item => {
                        const id = item.getAttribute('data-alert-id');
                        const isRead = !!(seen[kind] && seen[kind][id]);
                        item.classList.toggle('is-read', isRead);
                        if (!isRead) unread++;
                    });
                    if (badge) {
                        if (unread <= 0) badge.remove();
                        else badge.textContent = unread > 9 ? '9+' : String(unread);
                    }
                });
            };

            document.querySelectorAll('.header-panel-clear').forEach(btn => {
                btn.addEventListener('click', (e) => {
                    e.preventDefault();
                    e.stopPropagation();
                    const kind = btn.getAttribute('data-clear');
                    const drop = document.querySelector(`.header-dropdown[data-panel="${kind}"]`);
                    if (!drop || !kind) return;
                    const seen = readSeen();
                    seen[kind] = seen[kind] || {};
                    drop.querySelectorAll('.header-panel-item').forEach(item => {
                        const id = item.getAttribute('data-alert-id');
                        if (id) seen[kind][id] = true;
                    });
                    writeSeen(seen);
                    applySeenState();
                });
            });

            document.querySelectorAll('.header-panel-item').forEach(item => {
                item.addEventListener('click', () => {
                    const kind = item.getAttribute('data-kind');
                    const id = item.getAttribute('data-alert-id');
                    if (!kind || !id) return;
                    const seen = readSeen();
                    seen[kind] = seen[kind] || {};
                    seen[kind][id] = true;
                    writeSeen(seen);
                });
            });

            applySeenState();
        })();
    </script>
    <script>
        (function () {
            function bindUpload(root) {
                if (!root || root.dataset.bound === '1') return;
                root.dataset.bound = '1';

                const input = root.querySelector('.sf-upload-input');
                const box = root.querySelector('.sf-upload-box');
                const preview = root.querySelector('[data-sf-preview]');
                const empty = root.querySelector('[data-sf-empty]');
                const filename = root.querySelector('[data-sf-filename]');
                const clearBtn = root.querySelector('[data-sf-clear]');
                const removeCb = root.querySelector('[data-sf-remove]');
                if (!input || !box || !preview) return;

                const originalSrc = preview.getAttribute('src') || '';

                const setHasImage = (on) => {
                    root.classList.toggle('has-image', !!on);
                    preview.hidden = !on;
                    if (empty) empty.hidden = !!on;
                };

                const showPreview = (src, name) => {
                    preview.src = src;
                    setHasImage(true);
                    if (filename) filename.textContent = name || '';
                    if (clearBtn) clearBtn.hidden = false;
                    if (removeCb) removeCb.checked = false;
                };

                const reset = () => {
                    input.value = '';
                    if (originalSrc) {
                        preview.src = originalSrc;
                        setHasImage(true);
                        if (filename) filename.textContent = 'Current image';
                        if (clearBtn) clearBtn.hidden = false;
                    } else {
                        preview.removeAttribute('src');
                        setHasImage(false);
                        if (filename) filename.textContent = '';
                        if (clearBtn) clearBtn.hidden = true;
                    }
                    if (removeCb) removeCb.checked = false;
                };

                if (originalSrc) setHasImage(true);

                input.addEventListener('change', () => {
                    const file = input.files && input.files[0];
                    if (!file) return;
                    if (!file.type.startsWith('image/')) {
                        preview.removeAttribute('src');
                        preview.hidden = true;
                        root.classList.remove('has-image');
                        if (empty) {
                            empty.hidden = false;
                            empty.innerHTML = '<i class="bi bi-file-earmark-check"></i><span>File selected</span>';
                        }
                        if (filename) filename.textContent = file.name;
                        if (clearBtn) clearBtn.hidden = false;
                        if (removeCb) removeCb.checked = false;
                        return;
                    }
                    if (empty) {
                        empty.innerHTML = '<i class="bi bi-image"></i><span>No image selected</span>';
                    }
                    const reader = new FileReader();
                    reader.onload = () => showPreview(String(reader.result), file.name);
                    reader.readAsDataURL(file);
                });

                ['dragenter', 'dragover'].forEach(evt => {
                    box.addEventListener(evt, e => {
                        e.preventDefault();
                        e.stopPropagation();
                        box.classList.add('is-dragover');
                    });
                });
                ['dragleave', 'drop'].forEach(evt => {
                    box.addEventListener(evt, e => {
                        e.preventDefault();
                        e.stopPropagation();
                        box.classList.remove('is-dragover');
                    });
                });
                box.addEventListener('drop', e => {
                    const files = e.dataTransfer && e.dataTransfer.files;
                    if (!files || !files.length) return;
                    try {
                        const dt = new DataTransfer();
                        dt.items.add(files[0]);
                        input.files = dt.files;
                    } catch (_) {
                        return;
                    }
                    input.dispatchEvent(new Event('change'));
                });

                if (clearBtn) {
                    clearBtn.addEventListener('click', e => {
                        e.preventDefault();
                        if (originalSrc && removeCb) {
                            input.value = '';
                            preview.src = originalSrc;
                            setHasImage(true);
                            if (filename) filename.textContent = 'Marked for removal';
                            removeCb.checked = true;
                            clearBtn.hidden = true;
                        } else {
                            reset();
                        }
                    });
                }
            }

            document.querySelectorAll('[data-sf-upload]').forEach(bindUpload);
        })();
    </script>
    <script>
        (function () {
            document.querySelectorAll('[data-nav-toggle]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const group = btn.closest('[data-nav-group]');
                    if (!group) return;
                    group.classList.toggle('open');
                    btn.setAttribute('aria-expanded', group.classList.contains('open') ? 'true' : 'false');
                });
            });
        })();
    </script>
    <script>
        (function () {
            const input = document.getElementById('headerSearch');
            const panel = document.getElementById('headerSearchResults');
            if (!input || !panel) return;
            let timer = null;

            const hide = () => { panel.hidden = true; panel.innerHTML = ''; };
            const show = (html) => { panel.innerHTML = html; panel.hidden = false; };

            input.addEventListener('input', () => {
                clearTimeout(timer);
                const q = input.value.trim();
                if (q.length < 2) { hide(); return; }
                timer = setTimeout(async () => {
                    try {
                        const res = await fetch('/Admin/SearchSuggest?q=' + encodeURIComponent(q));
                        const data = await res.json();
                        if (!Array.isArray(data) || !data.length) {
                            show('<div class="header-search-empty">No matches</div>');
                            return;
                        }
                        show(data.map(r =>
                            `<a class="header-search-item" href="${r.url}">
                                <i class="bi ${r.icon || 'bi-search'}"></i>
                                <span><strong>${r.title}</strong><small>${r.category} · ${r.subtitle || ''}</small></span>
                             </a>`
                        ).join(''));
                    } catch {
                        hide();
                    }
                }, 220);
            });

            document.addEventListener('click', (e) => {
                if (!e.target.closest('#headerSearchWrap')) hide();
            });
        })();
    </script>
    <script>
        (function () {
            document.querySelectorAll('[data-pass-toggle]').forEach(btn => {
                btn.addEventListener('click', () => {
                    const wrap = btn.closest('.settings-input-wrap');
                    const input = wrap && wrap.querySelector('input');
                    const icon = btn.querySelector('i');
                    if (!input || !icon) return;
                    const show = input.type === 'password';
                    input.type = show ? 'text' : 'password';
                    btn.classList.toggle('is-on', show);
                    btn.setAttribute('aria-label', show ? 'Hide password' : 'Show password');
                    icon.className = show ? 'bi bi-eye-slash' : 'bi bi-eye';
                });
            });
        })();
    </script>
    @await RenderSectionAsync("Scripts", required: false)
</body>
</html>
