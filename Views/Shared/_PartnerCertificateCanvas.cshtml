@model SoftflipSolutions.Models.ChannelPartner
@{
    var owner = string.IsNullOrWhiteSpace(Model.OwnerName) ? Model.CompanyName : Model.OwnerName;
    var mobile = Model.Mobile ?? "";
    if (!string.IsNullOrWhiteSpace(mobile) && !mobile.StartsWith("+"))
        mobile = "+91 " + mobile.TrimStart('0');
    var initial = string.IsNullOrWhiteSpace(owner) ? "?" : owner.Trim()[0].ToString().ToUpperInvariant();
    var solutions = new (string Icon, string Label, string Tone)[]
    {
        ("bi-code-slash", "Software Development", "blue"),
        ("bi-globe2", "Website Development", "green"),
        ("bi-mortarboard", "School ERP", "blue"),
        ("bi-people", "HRMS & Payroll", "green"),
        ("bi-receipt", "Billing Software", "green"),
        ("bi-briefcase", "CRM Solutions", "blue"),
        ("bi-diagram-3", "MLM Software", "green"),
        ("bi-laptop", "Custom Software", "blue")
    };
}

<div class="pcert-canvas">
    <div class="pcert-waves" aria-hidden="true">
        <svg class="pcert-wave-svg" width="200" height="1123" viewBox="0 0 220 1123" xmlns="http://www.w3.org/2000/svg" preserveAspectRatio="none">
            <path fill="#b8e8f8" d="M0 0 H95 C145 90 40 180 110 280 C175 375 55 470 120 580 C180 680 50 780 105 880 C155 970 70 1040 95 1123 H0 Z" />
            <path fill="#5bc8ef" d="M0 0 H62 C115 110 25 210 85 320 C150 430 35 530 90 640 C145 750 30 850 78 960 C115 1040 50 1085 70 1123 H0 Z" />
            <path fill="#0b5ea8" d="M0 0 H38 C78 130 10 240 55 360 C105 490 15 600 58 730 C100 860 18 970 48 1123 H0 Z" />
            <path fill="#00aeef" fill-opacity="0.65" d="M0 420 C55 480 20 560 48 640 C78 720 15 800 40 880 C60 940 20 1000 0 1040 Z" />
        </svg>
    </div>
    <div class="pcert-dots" aria-hidden="true"></div>
    <div class="pcert-inner">
        <div class="pcert-brand">
            <img class="pcert-brand-logo" src="~/admin/img/softflip-logo.png" alt="Softflip" />
            <p class="pcert-brand-name"><span class="blue">SOFTFLIP</span> <span class="green">SOLUTIONS</span></p>
            <p class="pcert-tagline">— Smart Solutions, Better Future —</p>
        </div>

        <div class="pcert-authorised">AUTHORISED</div>

        <div class="pcert-title">
            <h1>TECHNOLOGY</h1>
            <h2>SUPPORT PARTNER</h2>
        </div>

        <div class="pcert-photo-wrap">
            <div class="pcert-photo">
                @if (!string.IsNullOrWhiteSpace(Model.PhotoPath))
                {
                    <img src="@Model.PhotoPath" alt="@owner" />
                }
                else
                {
                    @initial
                }
            </div>
            <div class="pcert-badge">
                <div class="pcert-badge-check">✓</div>
                <strong>TRUSTED<br />PARTNER</strong>
                <div class="stars" aria-hidden="true">
                    <span>★</span><span>★</span><span>★</span>
                </div>
            </div>
        </div>

        <div class="pcert-name-label">Partner Name</div>
        <div class="pcert-name-bar">@owner</div>

        <div class="pcert-mobile">
            <div class="pcert-mobile-ico"><i class="bi bi-telephone-fill"></i></div>
            <div class="pcert-mobile-copy">
                <small>Mobile Number</small>
                <strong>@mobile</strong>
            </div>
        </div>

        <div class="pcert-solutions-banner">OUR SOLUTIONS</div>
        <div class="pcert-solutions">
            @foreach (var s in solutions)
            {
                <div class="pcert-sol">
                    <span class="pcert-sol-ico @s.Tone"><i class="bi @s.Icon"></i></span>
                    <span class="pcert-sol-label">@s.Label</span>
                </div>
            }
        </div>

        <div class="pcert-rating">
            <div class="pcert-rating-left">
                <div class="pcert-rating-label">Client Rating</div>
                <div class="pcert-rating-stars" aria-label="4.5 out of 5">
                    <span class="on">★</span><span class="on">★</span><span class="on">★</span><span class="on">★</span><span class="half">★</span>
                </div>
            </div>
            <div class="pcert-rating-score">
                <strong>4.5 <em>/ 5</em></strong>
                <span>Based on Client Feedback</span>
            </div>
        </div>

        <div class="pcert-bottom">
            <div class="pcert-contacts">
                <div class="pcert-contact">
                    <span class="pcert-contact-ico blue"><i class="bi bi-globe2"></i></span>
                    <div class="pcert-contact-copy">
                        <small>Visit Our Website</small>
                        <strong>www.softflipsolutions.com</strong>
                    </div>
                </div>
                <div class="pcert-contact">
                    <span class="pcert-contact-ico green"><i class="bi bi-envelope-fill"></i></span>
                    <div class="pcert-contact-copy">
                        <small>Email Us</small>
                        <strong>info@softflipsolutions.com</strong>
                    </div>
                </div>
            </div>

            <div class="pcert-footer">
                <span><i class="bi bi-shield-check"></i> Reliable Support</span>
                <span class="pcert-footer-dot" aria-hidden="true"></span>
                <span><i class="bi bi-lightbulb"></i> Innovative Solutions</span>
                <span class="pcert-footer-dot" aria-hidden="true"></span>
                <span><i class="bi bi-graph-up-arrow"></i> Your Growth, Our Commitment</span>
            </div>
        </div>
    </div>
</div>
