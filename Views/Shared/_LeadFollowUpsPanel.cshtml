@model SoftflipSolutions.ViewModels.LeadFollowUpsPanelViewModel
@using SoftflipSolutions.Models
@{
    var defaultDue = DateTime.Today.AddDays(1).AddHours(10);
}

<div class="glass-card p-0 overflow-hidden mb-4">
    <div class="p-3 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-2 admin-table-header" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h5 class="mb-0">Scheduled follow-ups</h5>
            <p class="mb-0 small text-muted">Reminders with date &amp; time — separate from the call log</p>
        </div>
    </div>
    <div class="p-3">
        <form asp-action="AddFollowUp" method="post" class="row g-2 align-items-end mb-4">
            @Html.AntiForgeryToken()
            <input type="hidden" name="leadType" value="@Model.LeadType" />
            <input type="hidden" name="leadId" value="@Model.LeadId" />
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Step</label>
                <select name="stepType" class="form-select" required>
                    @foreach (var s in FollowUpSteps.All)
                    {
                        <option value="@s.Key" title="@s.Hint">@s.Label</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="form-label small text-muted mb-1">Due date &amp; time</label>
                <input type="datetime-local" name="dueAt" class="form-control" value="@defaultDue.ToString("yyyy-MM-ddTHH:mm")" required />
            </div>
            <div class="col-md-4">
                <label class="form-label small text-muted mb-1">Details / notes</label>
                <input type="text" name="note" class="form-control" maxlength="500" placeholder="e.g. Send CRM quotation as discussed…" required />
            </div>
            <div class="col-md-2">
                <button type="submit" class="btn btn-info w-100"><i class="bi bi-alarm me-1"></i> Add</button>
            </div>
        </form>

        <div class="fu-step-hints mb-3">
            @foreach (var s in FollowUpSteps.All.Take(4))
            {
                <span class="fu-step-hint"><i class="bi @s.Icon"></i> @s.Label</span>
            }
            <span class="fu-step-hint text-muted">+ notes &amp; more</span>
        </div>

        @{
            ViewData["FollowUpShowActions"] = true;
            ViewData["FollowUpCompleteAction"] = "CompleteFollowUp";
            ViewData["FollowUpCompleteController"] = "Admin";
        }
        <partial name="_FollowUpTimeline" model="Model.Items" />
    </div>
</div>
