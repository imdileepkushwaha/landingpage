@model SoftflipSolutions.Models.PartnerClient
@using SoftflipSolutions.Models
@using System.Text.Json
@{
    ViewData["Title"] = Model.Name;
    Layout = "_PartnerLayout";
    var initial = string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name.Substring(0, 1).ToUpper();
    var proposals = Model.Proposals?.OrderByDescending(p => p.CreatedAt).ToList() ?? new();
    var whatsapp = Model.WhatsApp ?? Model.Mobile;
    var services = ViewBag.Services as List<ServiceCatalog> ?? new();
    var servicesJson = JsonSerializer.Serialize(services.Select(s => new
    {
        id = s.Id,
        name = s.Name,
        budget = s.Budget,
        commission = s.Commission,
        panels = (s.Panels ?? new List<ServicePanel>()).Select(p => new
        {
            id = p.Id,
            name = p.Name,
            modules = (p.Modules ?? new List<ServiceModule>()).Select(m => new
            {
                id = m.Id,
                name = m.Name,
                subModules = (m.SubModules ?? new List<ServiceSubModule>()).Select(sm => new { id = sm.Id, name = sm.Name })
            })
        })
    }));
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success deal-alert">@TempData["SuccessMessage"]</div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger deal-alert">@TempData["ErrorMessage"]</div>
}

<div class="lead-detail-toolbar">
    <a asp-action="Clients" class="btn btn-lead-back">
        <i class="bi bi-arrow-left"></i> Back to clients
    </a>
    <div class="d-flex gap-2 flex-wrap">
        <a href="tel:@Model.Mobile" class="btn cp-link-btn"><i class="bi bi-telephone"></i> Call</a>
        <a href="https://wa.me/@(new string(whatsapp.Where(char.IsDigit).ToArray()))" target="_blank" rel="noopener" class="btn cp-link-btn">
            <i class="bi bi-whatsapp"></i> WhatsApp
        </a>
    </div>
</div>

<div class="cp-hero is-active mb-4">
    <div class="cp-hero-main">
        <div class="cp-hero-logo">
            <span>@initial</span>
        </div>
        <div class="cp-hero-copy">
            <div class="cp-hero-badges">
                <span class="cp-badge partner"><i class="bi bi-person-badge me-1"></i> Partner client</span>
                <span class="cp-badge success"><i class="bi bi-file-earmark-pdf me-1"></i> @proposals.Count proposals</span>
            </div>
            <h1>@Model.Name</h1>
            <p>
                <i class="bi bi-briefcase"></i> @Model.Requirement
                <span class="cp-dot">·</span>
                Added @Model.CreatedAt.ToString("dd MMM yyyy")
            </p>
        </div>
    </div>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="lead-profile-card">
            <div class="lead-profile-top">
                <h3>Contact</h3>
            </div>
            <div class="lead-profile-body">
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-telephone"></i></div>
                    <div>
                        <div class="lead-info-label">Mobile</div>
                        <a href="tel:@Model.Mobile">@Model.Mobile</a>
                    </div>
                </div>
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-whatsapp"></i></div>
                    <div>
                        <div class="lead-info-label">WhatsApp</div>
                        <strong>@whatsapp</strong>
                    </div>
                </div>
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-envelope"></i></div>
                    <div>
                        <div class="lead-info-label">Email</div>
                        <strong>@(Model.Email ?? "—")</strong>
                    </div>
                </div>
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-currency-rupee"></i></div>
                    <div>
                        <div class="lead-info-label">Budget</div>
                        <strong>@(Model.Budget ?? "—")</strong>
                    </div>
                </div>
                <div class="lead-info-row mb-0">
                    <div class="lead-info-icon"><i class="bi bi-calendar3"></i></div>
                    <div>
                        <div class="lead-info-label">Added</div>
                        <strong>@Model.CreatedAt.ToString("dd MMM yyyy HH:mm")</strong>
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        <div class="cp-card mb-4">
            <div class="cp-card-head">
                <div>
                    <h5><i class="bi bi-file-earmark-plus me-2"></i>Create quotation</h5>
                    <p>Select a service &amp; modules — PDF uses your company branding.</p>
                </div>
            </div>
            <div class="cp-card-body p-4">
                <form asp-action="CreateProposal" method="post" id="partnerProposalForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="clientId" value="@Model.Id" />
                    <div class="row g-3">
                        <div class="col-12">
                            <label class="form-label settings-label">Service</label>
                            <select name="serviceId" id="proposalServiceSelect" class="form-select settings-input" required>
                                <option value="">— Choose service —</option>
                                @foreach (var svc in services)
                                {
                                    <option value="@svc.Id" data-commission="@svc.Commission.ToString(System.Globalization.CultureInfo.InvariantCulture)">@svc.Name</option>
                                }
                            </select>
                            @if (!services.Any())
                            {
                                <div class="form-text text-muted">No services yet. <a asp-action="Services">View catalog</a> or contact admin.</div>
                            }
                        </div>
                        <div class="col-12" id="proposalModulesWrap" style="display:none;">
                            <label class="form-label settings-label">Included panels &amp; features</label>
                            <div id="proposalModulesTree" class="proposal-modules-tree proposal-modules-readonly"></div>
                            <div class="form-text text-muted mt-1">Admin-defined panels — view only</div>
                        </div>
                        <div class="col-12">
                            <label class="form-label settings-label">Title</label>
                            <input type="text" name="title" class="form-control settings-input" required value="Proposal for @Model.Name — @Model.Requirement" />
                        </div>
                        <div class="col-12">
                            <label class="form-label settings-label">Scope / details</label>
                            <div class="sf-quill-wrap">
                                <div id="proposalScopeEditor"></div>
                                <textarea name="scope" id="proposalScope" class="d-none" required></textarea>
                            </div>
                            <script type="text/template" id="proposalScopeSeed">
                                <p>Project scope based on: @Model.Requirement</p>
                                <ul>
                                    <li>Discovery &amp; requirement finalization</li>
                                    <li>Design / UI</li>
                                    <li>Development &amp; testing</li>
                                    <li>Deployment &amp; handover</li>
                                </ul>
                            </script>
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">New Price (₹)</label>
                            <input type="number" name="newPrice" id="proposalNewPrice" class="form-control settings-input" step="0.01" min="1" required placeholder="Enter quote price" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">Discount % <span class="text-muted fw-normal">(optional)</span></label>
                            <input type="number" name="discountPercent" id="proposalDiscount" class="form-control settings-input" step="0.01" min="0" max="100" placeholder="e.g. 10" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">Price after discount</label>
                            <input type="text" id="proposalFinalPrice" class="form-control settings-input" readonly value="—" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">Your commission (%)</label>
                            <input type="text" id="proposalCommission" class="form-control settings-input" readonly value="—" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">Valid days</label>
                            <input type="number" name="validDays" class="form-control settings-input" value="15" min="1" max="90" />
                        </div>
                        <div class="col-md-4">
                            <label class="form-label settings-label">Template</label>
                            <select name="templateKey" class="form-select settings-input">
                                @foreach (var t in ProposalTemplates.All)
                                {
                                    <option value="@t.Key">@t.Name</option>
                                }
                            </select>
                        </div>
                    </div>
                    <div class="settings-panel-actions mt-3 mb-0">
                        <button type="submit" class="btn btn-crm-primary">
                            <i class="bi bi-file-earmark-pdf me-1"></i> Generate proposal
                        </button>
                    </div>
                </form>
            </div>
        </div>

        <div class="cp-card">
            <div class="cp-card-head">
                <div>
                    <h5><i class="bi bi-files me-2"></i>Proposals</h5>
                    <p>Download, email, or share on WhatsApp.</p>
                </div>
            </div>
            <div class="cp-card-body p-0">
                @if (proposals.Any())
                {
                    <div class="table-responsive">
                        <table class="table table-borderless align-middle mb-0">
                            <thead>
                                <tr>
                                    <th>Title</th>
                                    <th>Amount</th>
                                    <th>Date</th>
                                    <th class="text-end">Actions</th>
                                </tr>
                            </thead>
                            <tbody>
                                @foreach (var p in proposals)
                                {
                                    var pdfUrl = !string.IsNullOrWhiteSpace(p.FilePath)
                                        ? $"https://{Context.Request.Host}{p.FilePath}"
                                        : Url.Action("DownloadProposal", "Partner", new { id = p.Id }, "https") ?? "";
                                    var waPhone = new string((whatsapp ?? "").Where(char.IsDigit).ToArray());
                                    var priceLine = p.DiscountPercent is > 0 && p.OriginalAmount is > 0
                                        ? $"New price: ₹ {p.OriginalAmount:N2}\nDiscount: {p.DiscountPercent:N2}%\nFinal: ₹ {p.Amount:N2}"
                                        : $"Amount: ₹ {p.Amount:N2}";
                                    var waText = Uri.EscapeDataString(
                                        $"Hi {Model.Name},\n\nPlease find our proposal: {p.Title}\n{priceLine}\nValid until: {p.ValidUntil:dd MMM yyyy}\n\nDownload: {pdfUrl}\n\n— {ViewBag.Partner?.CompanyName ?? "Partner"}");
                                    <tr>
                                        <td><strong>@p.Title</strong></td>
                                        <td>
                                            ₹ @p.Amount.ToString("N0")
                                            @if (p.DiscountPercent is > 0 && p.OriginalAmount is > 0)
                                            {
                                                <div class="small text-muted">New ₹ @p.OriginalAmount.Value.ToString("N0") · @p.DiscountPercent.Value.ToString("N1")% off</div>
                                            }
                                        </td>
                                        <td class="small text-muted">@p.CreatedAt.ToString("dd MMM yyyy")</td>
                                        <td class="text-end">
                                            <div class="admin-row-actions justify-content-end">
                                                <a class="btn btn-icon-action" asp-action="DownloadProposal" asp-route-id="@p.Id" title="Download PDF" target="_blank">
                                                    <i class="bi bi-file-earmark-pdf"></i>
                                                </a>
                                                @if (!string.IsNullOrWhiteSpace(Model.Email))
                                                {
                                                    <form asp-action="SendProposalEmail" method="post" class="d-inline">
                                                        @Html.AntiForgeryToken()
                                                        <input type="hidden" name="proposalId" value="@p.Id" />
                                                        <button type="submit" class="btn btn-icon-action edit" title="Email to client">
                                                            <i class="bi bi-envelope"></i>
                                                        </button>
                                                    </form>
                                                }
                                                @if (!string.IsNullOrWhiteSpace(waPhone))
                                                {
                                                    <a class="btn btn-icon-action" href="https://wa.me/@waPhone?text=@waText" target="_blank" rel="noopener" title="WhatsApp">
                                                        <i class="bi bi-whatsapp"></i>
                                                    </a>
                                                }
                                            </div>
                                        </td>
                                    </tr>
                                }
                            </tbody>
                        </table>
                    </div>
                }
                else
                {
                    <div class="text-center py-5 text-muted px-3">
                        <i class="bi bi-file-earmark-pdf display-6 d-block mb-2 opacity-50"></i>
                        No proposals yet for this client.
                    </div>
                }
            </div>
        </div>
    </div>
</div>

<script type="application/json" id="proposalServicesData">@Html.Raw(servicesJson)</script>
@section Styles {
    <link href="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.snow.css" rel="stylesheet" />
}
@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/quill@2.0.3/dist/quill.js"></script>
    <script>
        (function () {
            const servicesEl = document.getElementById('proposalServicesData');
            const serviceSelect = document.getElementById('proposalServiceSelect');
            const wrap = document.getElementById('proposalModulesWrap');
            const tree = document.getElementById('proposalModulesTree');
            if (!servicesEl || !serviceSelect || !wrap || !tree) return;

            const services = JSON.parse(servicesEl.textContent || '[]');

            function escapeHtml(str) {
                return String(str || '').replace(/[&<>"']/g, function (c) {
                    return ({ '&': '&amp;', '<': '&lt;', '>': '&gt;', '"': '&quot;', "'": '&#39;' })[c];
                });
            }

            function renderModules(serviceId) {
                tree.innerHTML = '';
                const svc = services.find(s => String(s.id) === String(serviceId));
                if (!svc || !svc.panels || !svc.panels.length) {
                    wrap.style.display = 'none';
                    return;
                }
                const hasAny = svc.panels.some(function (p) { return p.modules && p.modules.length; });
                if (!hasAny) {
                    wrap.style.display = 'none';
                    return;
                }
                wrap.style.display = '';
                svc.panels.forEach(function (panel) {
                    if (!panel.modules || !panel.modules.length) return;
                    const block = document.createElement('div');
                    block.className = 'proposal-module-block';
                    let html = '<div class="proposal-module-name"><i class="bi bi-window me-2"></i><strong>' + escapeHtml(panel.name) + '</strong></div>';
                    html += '<ul class="proposal-submodule-readonly">';
                    panel.modules.forEach(function (mod) {
                        if (mod.subModules && mod.subModules.length) {
                            mod.subModules.forEach(function (sub) {
                                html += '<li>' + escapeHtml(mod.name) + ' — ' + escapeHtml(sub.name) + '</li>';
                            });
                        } else {
                            html += '<li>' + escapeHtml(mod.name) + '</li>';
                        }
                    });
                    html += '</ul>';
                    block.innerHTML = html;
                    tree.appendChild(block);
                });
            }

            const commissionInput = document.getElementById('proposalCommission');
            const newPriceInput = document.getElementById('proposalNewPrice');
            const discountInput = document.getElementById('proposalDiscount');
            const finalPriceInput = document.getElementById('proposalFinalPrice');

            function formatInr(n) {
                return '₹ ' + Number(n || 0).toLocaleString('en-IN', { minimumFractionDigits: 2, maximumFractionDigits: 2 });
            }

            function recalcPrice() {
                const price = parseFloat(newPriceInput && newPriceInput.value);
                const disc = parseFloat(discountInput && discountInput.value);
                if (!Number.isFinite(price) || price <= 0) {
                    if (finalPriceInput) finalPriceInput.value = '—';
                    return;
                }
                if (Number.isFinite(disc) && disc > 0) {
                    const clamped = Math.min(100, Math.max(0, disc));
                    const finalAmt = Math.round(price * (1 - clamped / 100) * 100) / 100;
                    if (finalPriceInput) finalPriceInput.value = formatInr(finalAmt);
                } else {
                    if (finalPriceInput) finalPriceInput.value = formatInr(price);
                }
            }

            function applyServicePricing(serviceId) {
                if (!commissionInput) return;
                const opt = serviceSelect.options[serviceSelect.selectedIndex];
                const fromOption = opt && opt.value ? parseFloat(opt.getAttribute('data-commission')) : NaN;
                if (Number.isFinite(fromOption)) {
                    commissionInput.value = fromOption.toLocaleString('en-IN', { maximumFractionDigits: 2 }) + '%';
                    return;
                }
                const svc = services.find(s => String(s.id) === String(serviceId));
                if (!svc) {
                    commissionInput.value = '—';
                    return;
                }
                const c = Number(svc.commission != null ? svc.commission : 0);
                commissionInput.value = (Number.isFinite(c) ? c : 0).toLocaleString('en-IN', { maximumFractionDigits: 2 }) + '%';
            }

            serviceSelect.addEventListener('change', function () {
                renderModules(serviceSelect.value);
                applyServicePricing(serviceSelect.value);
            });
            applyServicePricing(serviceSelect.value);
            renderModules(serviceSelect.value);
            recalcPrice();

            // Quill rich text editor for Scope
            const scopeField = document.getElementById('proposalScope');
            const form = document.getElementById('partnerProposalForm');
            const seedEl = document.getElementById('proposalScopeSeed');
            let quill = null;

            function htmlToPlain(root) {
                const blocks = [];
                function walk(node, listPrefix) {
                    if (node.nodeType === Node.TEXT_NODE) {
                        const t = node.textContent.replace(/\u00a0/g, ' ');
                        if (t) blocks.push({ type: 'text', text: t });
                        return;
                    }
                    if (node.nodeType !== Node.ELEMENT_NODE) return;
                    const tag = node.tagName.toLowerCase();
                    if (tag === 'br') {
                        blocks.push({ type: 'br' });
                        return;
                    }
                    if (tag === 'li') {
                        const parts = [];
                        node.childNodes.forEach(function (c) {
                            if (c.nodeType === Node.TEXT_NODE) parts.push(c.textContent);
                            else if (c.nodeType === Node.ELEMENT_NODE && c.tagName.toLowerCase() !== 'ul' && c.tagName.toLowerCase() !== 'ol')
                                parts.push(c.textContent);
                        });
                        blocks.push({ type: 'li', text: parts.join('').replace(/\s+/g, ' ').trim(), prefix: listPrefix });
                        Array.from(node.children).forEach(function (c) {
                            if (c.tagName.toLowerCase() === 'ul') Array.from(c.children).forEach(function (li) { walk(li, '• '); });
                            if (c.tagName.toLowerCase() === 'ol') Array.from(c.children).forEach(function (li, i) { walk(li, (i + 1) + '. '); });
                        });
                        return;
                    }
                    if (tag === 'ul') {
                        Array.from(node.children).forEach(function (li) { walk(li, '• '); });
                        return;
                    }
                    if (tag === 'ol') {
                        Array.from(node.children).forEach(function (li, i) { walk(li, (i + 1) + '. '); });
                        return;
                    }
                    if (tag === 'h1' || tag === 'h2' || tag === 'h3' || tag === 'h4' || tag === 'blockquote' || tag === 'div' || tag === 'p') {
                        if (blocks.length && blocks[blocks.length - 1].type !== 'br' && blocks[blocks.length - 1].type !== 'li')
                            blocks.push({ type: 'br' });
                        node.childNodes.forEach(function (c) { walk(c, listPrefix); });
                        blocks.push({ type: 'br' });
                        return;
                    }
                    node.childNodes.forEach(function (c) { walk(c, listPrefix); });
                }
                walk(root, '');
                let out = '';
                blocks.forEach(function (b) {
                    if (b.type === 'br') out += '\n';
                    else if (b.type === 'li') out += (out && !out.endsWith('\n') ? '\n' : '') + (b.prefix || '• ') + b.text + '\n';
                    else out += b.text;
                });
                return out.replace(/\n{3,}/g, '\n\n').trim();
            }

            function syncScope() {
                if (!quill || !scopeField) return;
                const tmp = document.createElement('div');
                tmp.innerHTML = quill.root.innerHTML;
                scopeField.value = htmlToPlain(tmp);
            }

            if (document.getElementById('proposalScopeEditor') && window.Quill) {
                quill = new Quill('#proposalScopeEditor', {
                    theme: 'snow',
                    placeholder: 'Describe project scope…',
                    modules: {
                        toolbar: [
                            [{ header: [1, 2, 3, false] }],
                            ['bold', 'italic', 'underline', 'strike'],
                            [{ color: [] }, { background: [] }],
                            [{ list: 'ordered' }, { list: 'bullet' }],
                            [{ indent: '-1' }, { indent: '+1' }],
                            ['blockquote', 'link'],
                            ['clean']
                        ]
                    }
                });

                const seedHtml = seedEl ? seedEl.innerHTML.trim() : '';
                if (seedHtml) {
                    quill.clipboard.dangerouslyPasteHTML(seedHtml);
                }
                quill.on('text-change', syncScope);
                syncScope();
            }

            if (form) {
                form.addEventListener('submit', function (e) {
                    syncScope();
                    if (!scopeField || !scopeField.value.trim()) {
                        e.preventDefault();
                        alert('Please enter Scope / details.');
                        if (quill) quill.focus();
                    }
                });
            }

            if (newPriceInput) newPriceInput.addEventListener('input', recalcPrice);
            if (discountInput) discountInput.addEventListener('input', recalcPrice);
        })();
    </script>
}
