@{
    ViewData["Title"] = "Referral Link";
    Layout = "_PartnerLayout";
    var partner = ViewBag.Partner as SoftflipSolutions.Models.ChannelPartner;
    var shareUrl = ViewBag.ShareUrl as string ?? "";
    var waShare = ViewBag.WaShare as string ?? "#";
}

<div class="glass-card p-4 mb-4">
    <h4 class="mb-1" style="color:#152238">Referral / Share Link</h4>
    <p class="text-muted small mb-0">Share your Softflip partner link on WhatsApp, website or visiting card.</p>
</div>

<div class="glass-card p-4">
    <div class="mb-3">
        <label class="form-label small text-muted">Your referral code</label>
        <div class="form-control bg-light">@(partner?.ReferralCode ?? "—")</div>
    </div>
    <div class="mb-3">
        <label class="form-label small text-muted">Share URL</label>
        <div class="input-group">
            <input type="text" class="form-control" id="partnerShareUrl" value="@shareUrl" readonly />
            <button type="button" class="btn btn-crm-outline" onclick="navigator.clipboard.writeText(document.getElementById('partnerShareUrl').value)">Copy</button>
        </div>
    </div>
    <a href="@waShare" target="_blank" rel="noopener" class="btn btn-success">
        <i class="bi bi-whatsapp me-1"></i> Share on WhatsApp
    </a>
</div>
