@{
    ViewData["Title"] = "Create Invoice";
    Layout = "_PartnerLayout";
    var clients = ViewBag.Clients as List<SoftflipSolutions.Models.PartnerClient> ?? new();
    var selectedClientId = ViewBag.SelectedClientId as int?;
    var proposal = ViewBag.Proposal as SoftflipSolutions.Models.PartnerProposal;
}

<div class="glass-card p-4 mb-4">
    <h4 class="mb-1" style="color:#152238">Create Invoice</h4>
    <p class="text-muted small mb-0">Uses your bank / UPI details from Edit Profile on the PDF.</p>
</div>

<form asp-action="CreateInvoice" method="post" class="glass-card p-4">
    @Html.AntiForgeryToken()
    @if (proposal != null)
    {
        <input type="hidden" name="proposalId" value="@proposal.Id" />
        <div class="alert alert-info small">From proposal: <strong>@proposal.Title</strong> · ₹@proposal.Amount.ToString("N0")</div>
    }
    <div class="row g-3">
        <div class="col-md-6">
            <label class="form-label small text-muted">Client</label>
            <select name="clientId" class="form-select" required>
                <option value="">Select client…</option>
                @foreach (var c in clients)
                {
                    <option value="@c.Id" selected="@(selectedClientId == c.Id)">@c.Name</option>
                }
            </select>
        </div>
        <div class="col-md-6">
            <label class="form-label small text-muted">Title</label>
            <input type="text" name="title" class="form-control" required maxlength="200" value="@(proposal?.Title ?? "")" />
        </div>
        <div class="col-12">
            <label class="form-label small text-muted">Description</label>
            <textarea name="description" class="form-control" rows="3" maxlength="2000">@(proposal?.Scope ?? "")</textarea>
        </div>
        <div class="col-md-4">
            <label class="form-label small text-muted">Amount (₹)</label>
            <input type="number" step="0.01" min="1" name="amount" class="form-control" required value="@(proposal?.Amount ?? 0)" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">CGST</label>
            <input type="number" step="0.01" min="0" name="cgst" class="form-control" value="0" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">SGST</label>
            <input type="number" step="0.01" min="0" name="sgst" class="form-control" value="0" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">IGST</label>
            <input type="number" step="0.01" min="0" name="igst" class="form-control" value="0" />
        </div>
        <div class="col-md-2">
            <label class="form-label small text-muted">HSN/SAC</label>
            <input type="text" name="hsnSac" class="form-control" maxlength="20" />
        </div>
    </div>
    <div class="d-flex gap-2 justify-content-end mt-4 pt-3 border-top">
        <a asp-action="Invoices" class="btn btn-outline-secondary">Cancel</a>
        <button type="submit" class="btn btn-crm-primary"><i class="bi bi-receipt me-1"></i> Create</button>
    </div>
</form>
