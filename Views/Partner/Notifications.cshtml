@model List<SoftflipSolutions.Models.PartnerNotification>
@{
    ViewData["Title"] = "Notifications";
    Layout = "_PartnerLayout";
}

<div class="glass-card p-4 mb-4 d-flex flex-wrap justify-content-between align-items-center gap-2">
    <div>
        <h4 class="mb-1" style="color:#152238">Notifications</h4>
        <p class="text-muted small mb-0">Follow-ups, meetings and Softflip updates.</p>
    </div>
    <form asp-action="MarkAllNotificationsRead" method="post">
        @Html.AntiForgeryToken()
        <button type="submit" class="btn btn-crm-outline btn-sm">Mark all read</button>
    </form>
</div>

<div class="glass-card p-0 overflow-hidden">
    @if (Model.Count == 0)
    {
        <div class="p-4 text-muted">No notifications yet.</div>
    }
    else
    {
        <ul class="list-group list-group-flush">
            @foreach (var n in Model)
            {
                <li class="list-group-item d-flex justify-content-between align-items-start gap-3 @(n.IsRead ? "" : "bg-light")">
                    <div>
                        <div class="fw-semibold">@n.Title</div>
                        <div class="small text-muted">@n.Message</div>
                        <div class="small text-muted mt-1">@n.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</div>
                        @if (!string.IsNullOrWhiteSpace(n.Url))
                        {
                            <a href="@n.Url" class="small">Open</a>
                        }
                    </div>
                    @if (!n.IsRead)
                    {
                        <form asp-action="MarkNotificationRead" method="post">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@n.Id" />
                            <button type="submit" class="btn btn-sm btn-outline-secondary">Read</button>
                        </form>
                    }
                </li>
            }
        </ul>
    }
</div>
