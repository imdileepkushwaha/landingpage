@model IEnumerable<SoftflipSolutions.Models.PartnerMeeting>
@{
    ViewData["Title"] = "Meetings";
    Layout = "_PartnerLayout";
    var list = Model.ToList();
}

<div class="page-toolbar">
    <h2>Meetings</h2>
    <div class="toolbar-actions">
        <span class="toolbar-chip">
            <i class="bi bi-camera-video"></i>
            @list.Count active
        </span>
    </div>
</div>

@if (!list.Any())
{
    <div class="glass-card p-5 text-center text-muted">
        <i class="bi bi-camera-video fs-1 d-block mb-2"></i>
        No upcoming Softflip meetings right now.
    </div>
}
else
{
    <div class="row g-3">
        @foreach (var m in list)
        {
            <div class="col-lg-6">
                <div class="glass-card p-4 h-100">
                    <div class="d-flex justify-content-between align-items-start gap-2 mb-2">
                        <h5 class="mb-0">@m.Title</h5>
                        <span class="badge bg-success bg-opacity-25 text-success">Live</span>
                    </div>
                    <p class="mb-2">
                        <i class="bi bi-calendar-event me-1"></i>
                        <strong>@m.MeetingAt.ToString("dd MMM yyyy, hh:mm tt")</strong>
                    </p>
                    @if (!string.IsNullOrWhiteSpace(m.Notes))
                    {
                        <p class="small text-muted mb-3">@m.Notes</p>
                    }
                    <a href="@m.MeetingLink" target="_blank" rel="noopener" class="btn btn-crm-primary">
                        <i class="bi bi-box-arrow-up-right me-1"></i> Join meeting
                    </a>
                    <div class="small text-muted mt-2">Link available until meeting time</div>
                </div>
            </div>
        }
    </div>
}
