@model SoftflipSolutions.Models.ChannelPartner
@{
    ViewData["Title"] = "ID Card";
    Layout = "_PartnerLayout";
}

@section Styles {
    <link rel="stylesheet" href="~/css/partner-id-card.css" asp-append-version="true" />
}

<div class="glass-card p-4 mb-4">
    <h4 class="mb-1" style="color:#152238">Partner ID Card</h4>
    <p class="text-muted small mb-0">Your Softflip Technology Support Partner identity card.</p>
</div>

<div class="row g-4 align-items-start">
    <div class="col-lg-6">
        <div class="partner-pid-preview-wrap">
            <partial name="_PartnerIdCardCanvas" model="Model" />
        </div>
    </div>
    <div class="col-lg-5">
        <div class="glass-card p-4">
            <h6 class="mb-3" style="color:#152238">Share</h6>
            <div class="d-grid gap-2">
                <button type="button" class="btn btn-crm-primary" onclick="window.print()">
                    <i class="bi bi-printer me-1"></i> Print / Save as PDF
                </button>
            </div>
            <p class="small text-muted mt-3 mb-0">
                Use print dialog → <strong>Save as PDF</strong> to keep a copy of your ID card.
            </p>
        </div>
    </div>
</div>
