@model SoftflipSolutions.Models.Employee
@{
    ViewData["Title"] = "Edit Employee";
    Layout = "_AdminLayout";
}

@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger deal-alert alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="lead-detail-toolbar">
    <a asp-action="EmployeeDetails" asp-route-id="@Model.Id" class="btn btn-lead-back"><i class="bi bi-arrow-left"></i> Back to details</a>
    <div class="d-flex gap-2">
        <a asp-action="Employees" class="btn cp-link-btn">
            <i class="bi bi-list-ul"></i> All employees
        </a>
        <a asp-action="PunchAttendance" asp-route-employeeId="@Model.Id" class="btn cp-link-btn">
            <i class="bi bi-fingerprint"></i> Punch Attendance
        </a>
    </div>
</div>

<div class="glass-card p-4" style="max-width:820px;">
    <div class="mb-4">
        <h4 class="text-white mb-1">Edit Employee</h4>
        <p class="text-muted small mb-0">Update details for <strong class="text-white">@Model.FullName</strong> (@Model.EmployeeCode)</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="EditEmployee" asp-route-id="@Model.Id" method="post">
        @Html.AntiForgeryToken()
        <input type="hidden" asp-for="Id" />

        <div class="settings-section-label"><i class="bi bi-person-badge me-1"></i> Identity</div>
        <div class="row g-3 mb-4">
            <div class="col-md-4">
                <label class="form-label settings-label" asp-for="EmployeeCode"></label>
                <input asp-for="EmployeeCode" class="form-control settings-input" readonly tabindex="-1" />
                <div class="form-text settings-hint">System-generated · cannot change</div>
            </div>
            <div class="col-md-8">
                <label class="form-label settings-label" asp-for="FullName"></label>
                <input asp-for="FullName" class="form-control settings-input" required />
            </div>
        </div>

        <div class="settings-section-label"><i class="bi bi-briefcase me-1"></i> Role</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="Department"></label>
                <input asp-for="Department" class="form-control settings-input" required list="deptList" />
                <datalist id="deptList">
                    <option value="Engineering"></option>
                    <option value="Sales"></option>
                    <option value="HR"></option>
                    <option value="Finance"></option>
                    <option value="Operations"></option>
                    <option value="Support"></option>
                </datalist>
            </div>
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="Designation"></label>
                <input asp-for="Designation" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="DateOfJoining"></label>
                <input asp-for="DateOfJoining" type="date" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="ManagerId">Reporting manager</label>
                @{
                    var managers = ViewBag.Managers as IEnumerable<SoftflipSolutions.Models.Employee> ?? Enumerable.Empty<SoftflipSolutions.Models.Employee>();
                }
                <select asp-for="ManagerId" class="form-select settings-input">
                    <option value="">— None —</option>
                    @foreach (var mgr in managers)
                    {
                        <option value="@mgr.Id">@mgr.DisplayLabel</option>
                    }
                </select>
            </div>
            <div class="col-md-6 d-flex align-items-end">
                <div class="form-check form-switch mb-2">
                    <input asp-for="IsActive" class="form-check-input" type="checkbox" />
                    <label class="form-check-label settings-label" asp-for="IsActive">Active employee</label>
                </div>
            </div>
        </div>

        <div class="settings-section-label"><i class="bi bi-telephone me-1"></i> Contact</div>
        <div class="row g-3 mb-4">
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="Mobile"></label>
                <input asp-for="Mobile" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="form-label settings-label" asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control settings-input" required />
            </div>
            <div class="col-12">
                <label class="form-label settings-label" asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control settings-input" rows="2"></textarea>
            </div>
        </div>

        <div class="settings-panel-actions">
            <a asp-action="EmployeeDetails" asp-route-id="@Model.Id" class="btn btn-lead-back">Cancel</a>
            <button type="submit" class="btn btn-crm-primary">
                <i class="bi bi-check2-circle me-1"></i> Save changes
            </button>
        </div>
    </form>
</div>
