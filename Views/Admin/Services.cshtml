@model IEnumerable<SoftflipSolutions.Models.ServiceCatalog>
@{
    ViewData["Title"] = "Services";
    Layout = "_AdminLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-0 overflow-hidden">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3 admin-table-header" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h5 class="mb-1">Services</h5>
            <p class="mb-0 small text-muted">Catalog of products — upload modules via Excel, pick them when creating proposals</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-50 px-3 py-2 rounded-pill">Total: @Model.Count()</span>
            <a asp-action="AddService" class="btn btn-sm btn-info rounded-pill px-3 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Add Service
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-borderless mb-0 align-middle">
            <thead>
                <tr>
                    <th>Service</th>
                    <th>Budget</th>
                    <th>Commission %</th>
                    <th>Panels</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var s in Model)
                {
                    var panelCount = s.Panels?.Count ?? 0;
                    var featureCount = s.Panels?.Sum(p => p.Modules?.Count ?? 0) ?? 0;
                    <tr>
                        <td>
                            <div class="fw-bold">@s.Name</div>
                            <div class="small text-muted">@s.CreatedAt.ToString("dd MMM yyyy")</div>
                        </td>
                        <td>₹ @s.Budget.ToString("N0")</td>
                        <td>@s.Commission.ToString("0.##")%</td>
                        <td><span class="badge bg-info bg-opacity-25 text-info">@panelCount panels / @featureCount features</span></td>
                        <td>
                            @if (s.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success">Active</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="admin-row-actions">
                                <a asp-action="ServiceDetails" asp-route-id="@s.Id" class="btn btn-icon-action" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="EditService" asp-route-id="@s.Id" class="btn btn-icon-action edit" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-icon-action danger"
                                        title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteServiceModal"
                                        data-service-id="@s.Id"
                                        data-service-name="@s.Name">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="6" class="text-center py-5 text-muted">
                            <i class="bi bi-box-seam fs-1 d-block mb-2"></i>
                            No services yet. Add your first service and upload modules Excel.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteServiceModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-confirm-modal">
            <div class="modal-header border-0 pb-0">
                <div class="admin-confirm-ico"><i class="bi bi-trash3"></i></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title mb-2">Delete service?</h5>
                <p class="mb-0 text-muted">
                    This will permanently remove <strong id="deleteServiceName">this service</strong> and all its modules.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteService" method="post" id="deleteServiceForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteServiceId" value="" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('deleteServiceModal');
            if (!modal) return;
            modal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('deleteServiceId').value = btn.getAttribute('data-service-id') || '';
                document.getElementById('deleteServiceName').textContent = btn.getAttribute('data-service-name') || 'this service';
            });
        })();
    </script>
}
