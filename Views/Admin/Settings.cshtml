@{
    ViewData["Title"] = "Platform Settings";
    Layout = "_AdminLayout";
    var company = ViewBag.Company as SoftflipSolutions.Models.CompanyProfile ?? new SoftflipSolutions.Models.CompanyProfile();
    var activeTab = (ViewBag.ActiveSettingsTab as string) ?? "company";
    var access = ViewBag.EmployeeAccess as SoftflipSolutions.ViewModels.EmployeeAccessSettingsViewModel
        ?? new SoftflipSolutions.ViewModels.EmployeeAccessSettingsViewModel();
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success deal-alert alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger deal-alert alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row">
    <div class="col-md-3 mb-4">
        <div class="glass-card settings-nav-card">
            <div class="settings-nav-head">
                <span class="settings-nav-head-icon"><i class="bi bi-sliders"></i></span>
                <div>
                    <strong>Settings</strong>
                    <small>Platform preferences</small>
                </div>
            </div>
            <div class="nav flex-column nav-pills settings-nav" id="v-pills-tab" role="tablist">
                <button class="nav-link @(activeTab == "company" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-company" type="button">
                    <span class="settings-nav-ico company"><i class="bi bi-building"></i></span>
                    <span class="settings-nav-text">
                        <strong>Company</strong>
                        <small>Brand, bank &amp; UPI</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
                <button class="nav-link @(activeTab == "contacts" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-contacts" type="button">
                    <span class="settings-nav-ico contacts"><i class="bi bi-person-lines-fill"></i></span>
                    <span class="settings-nav-text">
                        <strong>Contacts</strong>
                        <small>Phone &amp; email</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
                <button class="nav-link @(activeTab == "signature" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-signature" type="button">
                    <span class="settings-nav-ico signature"><i class="bi bi-pen"></i></span>
                    <span class="settings-nav-text">
                        <strong>Signature</strong>
                        <small>PDF signatory</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
                <button class="nav-link @(activeTab == "smtp" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-smtp" type="button">
                    <span class="settings-nav-ico smtp"><i class="bi bi-envelope-fill"></i></span>
                    <span class="settings-nav-text">
                        <strong>Email (SMTP)</strong>
                        <small>Outgoing mail</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
                <button class="nav-link @(activeTab == "employee-access" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-employee-access" type="button">
                    <span class="settings-nav-ico contacts"><i class="bi bi-person-badge"></i></span>
                    <span class="settings-nav-text">
                        <strong>Employee access</strong>
                        <small>Login &amp; menus</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
                <button class="nav-link @(activeTab == "security" ? "active" : "")" data-bs-toggle="pill" data-bs-target="#tab-security" type="button">
                    <span class="settings-nav-ico security"><i class="bi bi-shield-lock-fill"></i></span>
                    <span class="settings-nav-text">
                        <strong>Security</strong>
                        <small>Admin password</small>
                    </span>
                    <i class="bi bi-chevron-right settings-nav-arrow"></i>
                </button>
            </div>
        </div>
    </div>

    <div class="col-md-9">
        <div class="tab-content">
            <div class="tab-pane fade @(activeTab == "company" ? "show active" : "")" id="tab-company">
                <div class="glass-card p-4 p-md-4">
                    <h4 class="mb-1"><i class="bi bi-building text-info me-2"></i> Company details</h4>
                    <p class="text-muted mb-4">Used on proposal &amp; invoice PDFs (logo, name, address, bank &amp; UPI).</p>
                    <form asp-action="UpdateCompany" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label settings-label">Company name</label>
                                <input type="text" name="CompanyName" class="form-control settings-input" value="@company.CompanyName" required />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Tagline</label>
                                <input type="text" name="Tagline" class="form-control settings-input" value="@company.Tagline" />
                            </div>
                            <div class="col-12">
                                <label class="form-label settings-label">Address</label>
                                <textarea name="Address" class="form-control settings-input" rows="2">@company.Address</textarea>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">GSTIN</label>
                                <input type="text" name="Gstin" class="form-control settings-input" value="@company.Gstin" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Website</label>
                                <input type="text" name="Website" class="form-control settings-input" value="@company.Website" placeholder="https://" />
                            </div>
                            <div class="col-12">
                                @{
                                    ViewData["UploadInputName"] = "LogoFile";
                                    ViewData["UploadLabel"] = "Company logo";
                                    ViewData["UploadHint"] = "PNG, JPG or WEBP · max 2 MB · used on proposals & invoices";
                                    ViewData["UploadCurrentUrl"] = company.HasLogo ? company.LogoPath : null;
                                    ViewData["UploadRemoveName"] = company.HasLogo ? "RemoveLogo" : null;
                                    ViewData["UploadRemoveId"] = "RemoveLogo";
                                    ViewData["UploadVariant"] = "logo";
                                }
                                <partial name="_ImageUpload" />
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top">
                            <h5 class="mb-1"><i class="bi bi-bank text-info me-2"></i> Bank account</h5>
                            <p class="text-muted small mb-3">Shown on invoice PDFs for payment.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label settings-label">Bank name</label>
                                    <input type="text" name="BankName" class="form-control settings-input" value="@company.BankName" placeholder="e.g. HDFC Bank" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label settings-label">Account holder name</label>
                                    <input type="text" name="BankAccountName" class="form-control settings-input" value="@company.BankAccountName" placeholder="Softflip Solutions" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label settings-label">Account number</label>
                                    <input type="text" name="BankAccountNumber" class="form-control settings-input" value="@company.BankAccountNumber" placeholder="XXXXXXXXXXXX" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label settings-label">IFSC code</label>
                                    <input type="text" name="BankIfsc" class="form-control settings-input" value="@company.BankIfsc" placeholder="HDFC0001234" />
                                </div>
                                <div class="col-12">
                                    <label class="form-label settings-label">Branch</label>
                                    <input type="text" name="BankBranch" class="form-control settings-input" value="@company.BankBranch" placeholder="City / branch name" />
                                </div>
                            </div>
                        </div>

                        <div class="mt-4 pt-4 border-top">
                            <h5 class="mb-1"><i class="bi bi-phone text-info me-2"></i> UPI</h5>
                            <p class="text-muted small mb-3">Optional — clients can pay via UPI apps.</p>
                            <div class="row g-3">
                                <div class="col-md-6">
                                    <label class="form-label settings-label">UPI ID</label>
                                    <input type="text" name="UpiId" class="form-control settings-input" value="@company.UpiId" placeholder="softflip@oksbi" />
                                </div>
                                <div class="col-md-6">
                                    <label class="form-label settings-label">UPI display name</label>
                                    <input type="text" name="UpiName" class="form-control settings-input" value="@company.UpiName" placeholder="Softflip Solutions" />
                                </div>
                            </div>
                        </div>

                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save company</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "contacts" ? "show active" : "")" id="tab-contacts">
                <div class="glass-card p-4 p-md-4">
                    <h4 class="mb-1"><i class="bi bi-person-lines-fill text-info me-2"></i> Contacts</h4>
                    <p class="text-muted mb-4">Shown on proposals so clients know how to reach you.</p>
                    <form asp-action="UpdateContacts" method="post">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label settings-label">Contact person</label>
                                <input type="text" name="ContactPerson" class="form-control settings-input" value="@company.ContactPerson" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Phone</label>
                                <input type="text" name="ContactPhone" class="form-control settings-input" value="@company.ContactPhone" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">WhatsApp number</label>
                                <input type="text" name="ContactWhatsApp" class="form-control settings-input" value="@company.ContactWhatsApp" placeholder="91XXXXXXXXXX" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Email</label>
                                <input type="email" name="ContactEmail" class="form-control settings-input" value="@company.ContactEmail" />
                            </div>
                        </div>
                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save contacts</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "signature" ? "show active" : "")" id="tab-signature">
                <div class="glass-card p-4 p-md-4">
                    <h4 class="mb-1"><i class="bi bi-pen text-info me-2"></i> Signature</h4>
                    <p class="text-muted mb-4">Appears at the bottom of proposal &amp; invoice PDFs.</p>
                    <form asp-action="UpdateSignature" method="post" enctype="multipart/form-data">
                        @Html.AntiForgeryToken()
                        <div class="row g-3">
                            <div class="col-md-6">
                                <label class="form-label settings-label">Signatory name</label>
                                <input type="text" name="SignatoryName" class="form-control settings-input" value="@company.SignatoryName" />
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Title</label>
                                <input type="text" name="SignatoryTitle" class="form-control settings-input" value="@company.SignatoryTitle" />
                            </div>
                            <div class="col-12">
                                @{
                                    ViewData["UploadInputName"] = "SignatureFile";
                                    ViewData["UploadLabel"] = "Signature image";
                                    ViewData["UploadHint"] = "PNG preferred · transparent background works best · max 2 MB";
                                    ViewData["UploadCurrentUrl"] = company.HasSignature ? company.SignaturePath : null;
                                    ViewData["UploadRemoveName"] = company.HasSignature ? "RemoveSignature" : null;
                                    ViewData["UploadRemoveId"] = "RemoveSignature";
                                    ViewData["UploadVariant"] = "signature";
                                }
                                <partial name="_ImageUpload" />
                            </div>
                        </div>
                        <div class="text-end mt-4 pt-3 border-top">
                            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save signature</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "smtp" ? "show active" : "")" id="tab-smtp">
                <div class="glass-card settings-panel">
                    <div class="settings-panel-head">
                        <div class="settings-panel-ico smtp"><i class="bi bi-envelope-at"></i></div>
                        <div>
                            <h4>SMTP configuration</h4>
                            <p>Required to email proposals and partner welcome messages.</p>
                        </div>
                    </div>
                    <form asp-action="UpdateSmtp" method="post" class="settings-panel-body">
                        @Html.AntiForgeryToken()
                        <div class="settings-section-label"><i class="bi bi-hdd-network me-1"></i> Server</div>
                        <div class="row g-3 mb-4">
                            <div class="col-md-8">
                                <label class="form-label settings-label">SMTP host</label>
                                <div class="settings-input-wrap">
                                    <i class="bi bi-server settings-input-ico"></i>
                                    <input type="text" name="SmtpHost" class="form-control settings-input has-ico" placeholder="e.g. smtp.gmail.com" value="@ViewBag.SmtpHost" required>
                                </div>
                            </div>
                            <div class="col-md-4">
                                <label class="form-label settings-label">Port</label>
                                <div class="settings-input-wrap">
                                    <i class="bi bi-plug settings-input-ico"></i>
                                    <input type="number" name="SmtpPort" class="form-control settings-input has-ico" placeholder="587" value="@ViewBag.SmtpPort" required>
                                </div>
                            </div>
                        </div>

                        <div class="settings-section-label"><i class="bi bi-person-badge me-1"></i> Sender account</div>
                        <div class="row g-3 mb-4">
                            <div class="col-12">
                                <label class="form-label settings-label">Email address</label>
                                <div class="settings-input-wrap">
                                    <i class="bi bi-envelope settings-input-ico"></i>
                                    <input type="email" name="SmtpEmail" class="form-control settings-input has-ico" placeholder="your@email.com" value="@ViewBag.SmtpEmail" required>
                                </div>
                            </div>
                            <div class="col-12">
                                <label class="form-label settings-label">Password / App password</label>
                                <div class="settings-input-wrap password">
                                    <i class="bi bi-key settings-input-ico"></i>
                                    <input type="password" name="SmtpPassword" class="form-control settings-input has-ico has-toggle" placeholder="••••••••••••" value="@ViewBag.SmtpPassword" required autocomplete="current-password">
                                    <button type="button" class="settings-pass-toggle" data-pass-toggle aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="settings-ssl-card mb-4">
                            <div class="form-check form-switch mb-0">
                                <input class="form-check-input" type="checkbox" role="switch" id="SmtpEnableSsl" name="SmtpEnableSsl" @(ViewBag.SmtpEnableSsl == true ? "checked" : "")>
                                <label class="form-check-label" for="SmtpEnableSsl">
                                    <strong>Enable SSL / TLS</strong>
                                    <span>Encrypt connection to the mail server (recommended)</span>
                                </label>
                            </div>
                        </div>

                        <div class="settings-panel-actions">
                            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save SMTP</button>
                        </div>
                    </form>
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "employee-access" ? "show active" : "")" id="tab-employee-access">
                <div class="glass-card p-4">
                    <h4 class="mb-1"><i class="bi bi-person-badge text-info me-2"></i> Employee access &amp; menus</h4>
                    <p class="text-muted mb-4">
                        Enable panel login and choose which menus each employee can see.
                        Login URL: <a href="@access.EmployeeLoginUrl" target="_blank" rel="noopener">@access.EmployeeLoginUrl</a>
                    </p>

                    @if (!access.Employees.Any())
                    {
                        <div class="text-muted py-4 text-center">
                            <i class="bi bi-people fs-1 d-block mb-2"></i>
                            No employees yet. <a asp-action="AddEmployee">Add an employee</a> first.
                        </div>
                    }
                    else
                    {
                        <form method="get" asp-action="Settings" class="mb-4">
                            <input type="hidden" name="employeeId" id="settingsEmpPicker" value="@access.SelectedEmployeeId" />
                            <label class="form-label settings-label">Select employee</label>
                            <select class="form-select settings-input" onchange="location.href='@Url.Action("Settings")?employeeId='+this.value+'#tab-employee-access'">
                                @foreach (var e in access.Employees)
                                {
                                    if (e.Id == access.SelectedEmployeeId)
                                    {
                                        <option value="@e.Id" selected>@e.DisplayLabel @(e.CanLogin ? "· Login ON" : "") @(e.IsActive ? "" : "· Inactive")</option>
                                    }
                                    else
                                    {
                                        <option value="@e.Id">@e.DisplayLabel @(e.CanLogin ? "· Login ON" : "") @(e.IsActive ? "" : "· Inactive")</option>
                                    }
                                }
                            </select>
                        </form>

                        @if (access.SelectedEmployee != null)
                        {
                            var emp = access.SelectedEmployee;
                            <form asp-action="UpdateEmployeeAccess" method="post">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="employeeId" value="@emp.Id" />

                                <div class="settings-user-chip mb-4">
                                    <span class="settings-user-avatar">@(emp.FullName.Substring(0, 1).ToUpper())</span>
                                    <div>
                                        <strong>@emp.FullName</strong>
                                        <small>@emp.Email · @emp.Designation</small>
                                    </div>
                                </div>

                                <div class="settings-ssl-card mb-4">
                                    <div class="form-check form-switch mb-0">
                                        <input class="form-check-input" type="checkbox" role="switch" id="canLogin" name="canLogin" value="true" @(access.CanLogin ? "checked" : "")>
                                        <label class="form-check-label" for="canLogin">
                                            <strong>Enable employee panel login</strong>
                                            <span>Allow this employee to sign in at /Employee/Login</span>
                                        </label>
                                    </div>
                                </div>

                                <div class="mb-4" style="max-width:360px;">
                                    <label class="form-label settings-label">Panel password @(string.IsNullOrEmpty(emp.PasswordHash) ? "(required to enable)" : "(leave blank to keep)")</label>
                                    <div class="settings-input-wrap password">
                                        <i class="bi bi-key settings-input-ico"></i>
                                        <input type="password" name="password" class="form-control settings-input has-ico has-toggle" minlength="4" autocomplete="new-password" placeholder="Set / reset password" />
                                        <button type="button" class="settings-pass-toggle" data-pass-toggle aria-label="Show password">
                                            <i class="bi bi-eye"></i>
                                        </button>
                                    </div>
                                </div>

                                <div class="settings-section-label"><i class="bi bi-list-check me-1"></i> Menus visible in employee panel</div>
                                <div class="row g-3 mb-4">
                                    @foreach (var menu in access.MenuCatalog)
                                    {
                                        var checkedAttr = access.SelectedMenus.Contains(menu.Key) || (access.CanLogin && !access.SelectedMenus.Any() && SoftflipSolutions.Services.EmployeeMenuCatalog.DefaultKeys.Contains(menu.Key));
                                        <div class="col-md-6">
                                            <div class="settings-ssl-card h-100">
                                                <div class="form-check mb-0">
                                                    <input class="form-check-input" type="checkbox" name="menus" value="@menu.Key" id="menu_@menu.Key"
                                                           @(checkedAttr ? "checked" : "")>
                                                    <label class="form-check-label" for="menu_@menu.Key">
                                                        <strong><i class="bi @menu.Icon me-1"></i> @menu.Label</strong>
                                                        <span>@menu.Section · @(menu.Description ?? menu.Label)</span>
                                                    </label>
                                                </div>
                                            </div>
                                        </div>
                                    }
                                </div>

                                <div class="settings-panel-actions">
                                    <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save employee access</button>
                                </div>
                            </form>
                        }
                    }
                </div>
            </div>

            <div class="tab-pane fade @(activeTab == "security" ? "show active" : "")" id="tab-security">
                <div class="glass-card settings-panel">
                    <div class="settings-panel-head">
                        <div class="settings-panel-ico security"><i class="bi bi-shield-lock"></i></div>
                        <div>
                            <h4>Change password</h4>
                            <p>Keep your administrator account secure with a strong password.</p>
                        </div>
                    </div>
                    <form asp-action="UpdateSecurity" method="post" class="settings-panel-body">
                        @Html.AntiForgeryToken()
                        <div class="settings-user-chip mb-4">
                            <span class="settings-user-avatar">@((ViewBag.AdminUsername as string ?? "A").Substring(0, 1).ToUpper())</span>
                            <div>
                                <strong>@ViewBag.AdminUsername</strong>
                                <small>Administrator account</small>
                            </div>
                        </div>

                        <div class="mb-3">
                            <label class="form-label settings-label">Current password</label>
                            <div class="settings-input-wrap password">
                                <i class="bi bi-lock settings-input-ico"></i>
                                <input type="password" name="currentPassword" class="form-control settings-input has-ico has-toggle" required autocomplete="current-password">
                                <button type="button" class="settings-pass-toggle" data-pass-toggle aria-label="Show password">
                                    <i class="bi bi-eye"></i>
                                </button>
                            </div>
                        </div>

                        <div class="row g-3 mb-2">
                            <div class="col-md-6">
                                <label class="form-label settings-label">New password</label>
                                <div class="settings-input-wrap password">
                                    <i class="bi bi-shield-check settings-input-ico"></i>
                                    <input type="password" name="newPassword" class="form-control settings-input has-ico has-toggle" required minlength="6" autocomplete="new-password">
                                    <button type="button" class="settings-pass-toggle" data-pass-toggle aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                                <div class="form-text settings-hint">Minimum 6 characters</div>
                            </div>
                            <div class="col-md-6">
                                <label class="form-label settings-label">Confirm new password</label>
                                <div class="settings-input-wrap password">
                                    <i class="bi bi-shield-check settings-input-ico"></i>
                                    <input type="password" name="confirmPassword" class="form-control settings-input has-ico has-toggle" required minlength="6" autocomplete="new-password">
                                    <button type="button" class="settings-pass-toggle" data-pass-toggle aria-label="Show password">
                                        <i class="bi bi-eye"></i>
                                    </button>
                                </div>
                            </div>
                        </div>

                        <div class="settings-panel-actions">
                            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-shield-check me-1"></i> Update password</button>
                        </div>
                    </form>
                </div>
            </div>
        </div>
    </div>
</div>
