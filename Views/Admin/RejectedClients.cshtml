@{
    ViewData["Title"] = "Rejected Leads";
    Layout = "_AdminLayout";
    
    var enquiries = ViewBag.Enquiries as List<SoftflipSolutions.Models.Enquiry>;
    var demoRequests = ViewBag.DemoRequests as List<SoftflipSolutions.Models.DemoRequest>;
    var clientLeads = ViewBag.ClientLeads as List<SoftflipSolutions.Models.ClientLead>;
}



<div class="glass-card">
    <ul class="nav nav-pills nav-pills-danger mb-4" id="rejectedTabs" role="tablist">
        <li class="nav-item me-2" role="presentation">
            <button class="nav-link active" id="enquiries-tab" data-bs-toggle="pill" data-bs-target="#enquiries" type="button" role="tab">
                <i class="bi bi-chat-left-text me-1"></i> General Enquiries
            </button>
        </li>
        <li class="nav-item me-2" role="presentation">
            <button class="nav-link" id="demos-tab" data-bs-toggle="pill" data-bs-target="#demos" type="button" role="tab">
                <i class="bi bi-laptop me-1"></i> Demo Requests
            </button>
        </li>
        <li class="nav-item" role="presentation">
            <button class="nav-link" id="external-tab" data-bs-toggle="pill" data-bs-target="#external" type="button" role="tab">
                <i class="bi bi-people me-1"></i> External Clients
            </button>
        </li>
    </ul>

    <div class="tab-content" id="rejectedTabsContent">
        <div class="tab-pane fade show active" id="enquiries" role="tabpanel">
            <div class="table-responsive">
                <table class="table custom-table table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Rejected On</th>
                            <th>Client Info</th>
                            <th>Requirement</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (enquiries != null && enquiries.Any())
                        {
                            foreach (var item in enquiries)
                            {
                                <tr>
                                    <td>
                                        <div class="text-white-50"><i class="bi bi-calendar3 me-2"></i>@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white">@item.Name</div>
                                        <div class="small text-white-50">@item.Email</div>
                                        <div class="small text-white-50">@item.Phone</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-50 text-white px-3 py-2 rounded-pill">
                                            @item.Requirement
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i> Rejected
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="EnquiryDetails" asp-route-id="@item.Id" class="btn btn-icon-action" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-folder-x display-4 text-white-50 mb-3 d-block"></i>
                                    <h5 class="text-white-50">No Rejected Enquiries</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="demos" role="tabpanel">
            <div class="table-responsive">
                <table class="table custom-table table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Rejected On</th>
                            <th>Company & Contact</th>
                            <th>Product Interest</th>
                            <th>Status</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (demoRequests != null && demoRequests.Any())
                        {
                            foreach (var item in demoRequests)
                            {
                                <tr>
                                    <td>
                                        <div class="text-white-50"><i class="bi bi-calendar3 me-2"></i>@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white">@item.CompanyName</div>
                                        <div class="small text-white-50">@item.Name (@item.Email)</div>
                                    </td>
                                    <td>
                                        <span class="badge bg-secondary bg-opacity-25 border border-secondary border-opacity-50 text-white px-3 py-2 rounded-pill">
                                            @item.Requirement
                                        </span>
                                    </td>
                                    <td>
                                        <span class="badge bg-danger bg-opacity-25 text-danger border border-danger border-opacity-50 rounded-pill px-3 py-1">
                                            <i class="bi bi-x-circle me-1"></i> Rejected
                                        </span>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="DemoRequestDetails" asp-route-id="@item.Id" class="btn btn-icon-action" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-folder-x display-4 text-white-50 mb-3 d-block"></i>
                                    <h5 class="text-white-50">No Rejected Demo Requests</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>

        <div class="tab-pane fade" id="external" role="tabpanel">
            <div class="table-responsive">
                <table class="table custom-table table-borderless align-middle mb-0">
                    <thead>
                        <tr>
                            <th>Rejected On</th>
                            <th>Client Info</th>
                            <th>Source</th>
                            <th>Requirement / Budget</th>
                            <th class="text-end">Actions</th>
                        </tr>
                    </thead>
                    <tbody>
                        @if (clientLeads != null && clientLeads.Any())
                        {
                            foreach (var item in clientLeads)
                            {
                                <tr>
                                    <td>
                                        <div class="text-white-50"><i class="bi bi-calendar3 me-2"></i>@item.CreatedAt.ToString("MMM dd, yyyy")</div>
                                    </td>
                                    <td>
                                        <div class="fw-bold text-white">@item.Name</div>
                                        <div class="small text-white-50">@item.Mobile</div>
                                        @if (!string.IsNullOrWhiteSpace(item.Email))
                                        {
                                            <div class="small text-white-50">@item.Email</div>
                                        }
                                    </td>
                                    <td>
                                        <span class="badge bg-info bg-opacity-25 text-info border border-info border-opacity-50 rounded-pill px-3 py-1">@item.Source</span>
                                    </td>
                                    <td>
                                        <div class="text-white">@item.Requirement</div>
                                        <div class="small text-white-50">Budget: @(string.IsNullOrWhiteSpace(item.Budget) ? "—" : item.Budget)</div>
                                    </td>
                                    <td class="text-end">
                                        <a asp-action="ClientLeadDetails" asp-route-id="@item.Id" class="btn btn-icon-action" title="View"><i class="bi bi-eye"></i></a>
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="5" class="text-center py-5">
                                    <i class="bi bi-folder-x display-4 text-white-50 mb-3 d-block"></i>
                                    <h5 class="text-white-50">No Rejected External Clients</h5>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
    </div>
</div>
