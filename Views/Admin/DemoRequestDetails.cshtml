@model SoftflipSolutions.Models.DemoRequest
@using SoftflipSolutions.Models
@{
    ViewData["Title"] = string.IsNullOrWhiteSpace(Model.Name) ? "Demo request" : Model.Name;
    ViewData["PageSection"] = "Demo Requests";
    Layout = "_AdminLayout";
    ViewBag.SuppressDealAlerts = true;

    var status = string.IsNullOrEmpty(Model.Status) ? LeadPipeline.Pending : Model.Status;
    var statusClass = LeadPipeline.BadgeClass(status);
    var statusIcon = LeadPipeline.BadgeIcon(status);
    var statusLabel = LeadPipeline.DisplayName(status);
    var initial = string.IsNullOrEmpty(Model.Name) ? "?" : Model.Name.Substring(0, 1).ToUpper();
    var dealPanel = ViewBag.DealPanel as SoftflipSolutions.ViewModels.LeadDealPanelViewModel;
    var documentsPanel = ViewBag.DocumentsPanel as SoftflipSolutions.ViewModels.LeadDocumentsPanelViewModel;
    var followUpsPanel = ViewBag.FollowUpsPanel as SoftflipSolutions.ViewModels.LeadFollowUpsPanelViewModel;
    var partnerAssignPanel = ViewBag.PartnerAssignPanel as SoftflipSolutions.ViewModels.LeadPartnerAssignPanelViewModel;
    var duplicates = ViewBag.DuplicateLeads as IEnumerable<SoftflipSolutions.ViewModels.DuplicateLeadMatch>;
    var showDealTab = dealPanel != null && (LeadPipeline.IsActiveDeal(status) || status == LeadPipeline.Confirmed);
    var noteCount = Model.Notes?.Count ?? 0;
    var followUpOpen = followUpsPanel?.Items.Count(x => !x.IsDone) ?? 0;
    var docCount = documentsPanel?.Documents.Count ?? 0;

    var defaultTab = status == LeadPipeline.Confirmed && dealPanel?.LatestProposal == null ? "deal" : "notes";
    if (!showDealTab && defaultTab == "deal") defaultTab = "notes";
    ViewBag.LeadTabStorageKey = "lead-tab-demo-" + Model.Id;
    ViewBag.LeadDefaultTab = defaultTab;

    var waDigits = new string((Model.Phone ?? "").Where(char.IsDigit).ToArray());
    if (waDigits.Length == 10) waDigits = "91" + waDigits;
    var templates = ViewBag.MessageTemplates as IEnumerable<MessageTemplate> ?? Enumerable.Empty<MessageTemplate>();
    var waTemplates = templates.Where(t => t.Channel == "WhatsApp").ToList();
    var canContact = status != LeadPipeline.Rejected;
    var hasWa = waDigits.Length >= 10;
}

<div class="lead-detail-toolbar">
    <a asp-action="DemoRequests" class="btn btn-lead-back">
        <i class="bi bi-arrow-left"></i> Back to Demo Requests
    </a>
    <div class="lead-detail-meta">
        <span><i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
        <span class="badge bg-@statusClass"><i class="bi @statusIcon me-1"></i>@statusLabel</span>
    </div>
</div>

<partial name="_LeadFlash" />

@if (duplicates != null)
{
    <partial name="_DuplicateLeadsAlert" model="duplicates" />
}

@if (status == LeadPipeline.Pending)
{
    <div class="lead-action-bar mb-4">
        <div class="lead-action-copy">
            <div class="lead-action-icon warning"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <h5>Decision pending</h5>
                <p>Have you conducted the demo? Confirm or reject this request.</p>
            </div>
        </div>
        <div class="lead-action-buttons">
            <form asp-action="UpdateDemoRequestStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@LeadPipeline.Confirmed" />
                <button type="submit" class="btn btn-lead-success"><i class="bi bi-check2-circle"></i> Confirm demo</button>
            </form>
            <form asp-action="UpdateDemoRequestStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@LeadPipeline.Rejected" />
                <button type="submit" class="btn btn-lead-danger" onclick="return confirm('Reject this demo request?');"><i class="bi bi-x-circle"></i> Reject</button>
            </form>
        </div>
    </div>
}

<div class="lead-hero">
    <div class="lead-hero-top">
        <div class="lead-hero-id">
            <div class="lead-avatar">@initial</div>
            <div>
                <h2>@Model.Name</h2>
                <div class="lead-hero-meta">
                    <span class="lead-type-pill">Demo request</span>
                    <span class="badge bg-@statusClass"><i class="bi @statusIcon me-1"></i>@statusLabel</span>
                    <span class="lead-hero-date">Added @Model.CreatedAt.ToString("dd MMM yyyy")</span>
                </div>
            </div>
        </div>
        <div class="lead-hero-actions">
            @if (canContact && !string.IsNullOrWhiteSpace(Model.Phone))
            {
                <a class="lead-quick-btn" href="tel:@Model.Phone"><i class="bi bi-telephone"></i> Call</a>
            }
            @if (canContact && hasWa && waTemplates.Any())
            {
                    <div class="dropdown">
                        <button class="lead-quick-btn wa dropdown-toggle" type="button" data-bs-toggle="dropdown" aria-expanded="false">
                            <i class="bi bi-whatsapp"></i> WhatsApp
                        </button>
                        <ul class="dropdown-menu dropdown-menu-end">
                            <li>
                                <a class="dropdown-item" href="https://wa.me/@waDigits" target="_blank" rel="noopener">
                                    <i class="bi bi-chat-dots me-2"></i> Chat on WhatsApp
                                </a>
                            </li>
                            @foreach (var t in waTemplates)
                            {
                                var body = t.Body
                                    .Replace("{{Name}}", Model.Name, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Requirement}}", Model.Requirement, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Phone}}", Model.Phone, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Email}}", Model.Email ?? "", StringComparison.OrdinalIgnoreCase);
                                var waUrl = $"https://wa.me/{waDigits}?text={Uri.EscapeDataString(body)}";
                                <li><a class="dropdown-item" href="@waUrl" target="_blank" rel="noopener">@t.Name</a></li>
                            }
                        </ul>
                    </div>
            }
            else if (canContact && hasWa)
            {
                    <a class="lead-quick-btn wa" href="https://wa.me/@waDigits" target="_blank" rel="noopener">
                        <i class="bi bi-whatsapp"></i> WhatsApp
                    </a>
            }
            @if (canContact && !string.IsNullOrWhiteSpace(Model.Email))
            {
                <button type="button" class="lead-quick-btn" data-bs-toggle="modal" data-bs-target="#emailModal">
                    <i class="bi bi-envelope"></i> Email
                </button>
            }
            @if (!string.IsNullOrWhiteSpace(Model.Phone))
            {
                <button type="button" class="lead-quick-btn" data-copy-text="@Model.Phone">
                    <i class="bi bi-clipboard"></i> Copy number
                </button>
            }
            <a asp-action="EditDemoRequest" asp-route-id="@Model.Id" class="lead-quick-btn">
                <i class="bi bi-pencil"></i> Edit contact
            </a>
        </div>
    </div>

    <div class="lead-hero-grid">
        <div class="lead-hero-field">
            <div class="lead-info-label">Company</div>
            <span class="lead-hero-value">@Model.CompanyName</span>
        </div>
        <div class="lead-hero-field">
            <div class="lead-info-label">Phone</div>
            <a href="tel:@Model.Phone">@Model.Phone</a>
        </div>
        <div class="lead-hero-field">
            <div class="lead-info-label">Email</div>
            <a href="mailto:@Model.Email">@Model.Email</a>
        </div>
        <div class="lead-hero-field">
            <div class="lead-info-label">Requested product</div>
            <span class="badge bg-secondary">@Model.Requirement</span>
        </div>
        <div class="lead-hero-field lead-hero-message">
            <div class="lead-info-label">Original message</div>
            <div class="lead-message-box">
                <p>@(string.IsNullOrWhiteSpace(Model.Message) ? "No message provided." : Model.Message)</p>
            </div>
        </div>
    </div>
</div>

@if (showDealTab && status == LeadPipeline.Confirmed && dealPanel?.LatestProposal == null)
{
    <div class="lead-next-bar">
        <div>
            <strong>Next: generate a proposal</strong>
            <p>Demo is confirmed. Create a proposal PDF and share it on WhatsApp or email.</p>
        </div>
        <button type="button" class="btn btn-crm-primary" data-open-tab="deal">
            <i class="bi bi-file-earmark-plus me-1"></i> Open deal
        </button>
    </div>
}
else if (showDealTab && status == LeadPipeline.ProposalSent)
{
    <div class="lead-next-bar">
        <div>
            <strong>Next: convert to invoice</strong>
            <p>Proposal is out. When the client agrees, raise an invoice from the Deal tab.</p>
        </div>
        <button type="button" class="btn btn-crm-primary" data-open-tab="deal">Open deal</button>
    </div>
}
else if (showDealTab && status == LeadPipeline.Invoiced)
{
    <div class="lead-next-bar">
        <div>
            <strong>Next: collect payment</strong>
            <p>Invoice is ready. Follow up for payment and mark it paid when received.</p>
        </div>
        <button type="button" class="btn btn-crm-primary" data-open-tab="deal">Open deal</button>
    </div>
}

<div class="lead-workspace" id="leadWorkspace">
    <ul class="nav lead-workspace-tabs" role="tablist">
        <li class="nav-item" role="presentation">
            <button class="nav-link @(defaultTab == "notes" ? "active" : null)" data-bs-toggle="tab" data-bs-target="#lead-tab-notes" data-lead-tab="notes" type="button" role="tab">
                Call log
                @if (noteCount > 0)
                {
                    <span class="lead-tab-count">@noteCount</span>
                }
            </button>
        </li>
        @if (followUpsPanel != null)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(defaultTab == "followups" ? "active" : null)" data-bs-toggle="tab" data-bs-target="#lead-tab-followups" data-lead-tab="followups" type="button" role="tab">
                    Follow-ups
                    @if (followUpOpen > 0)
                    {
                        <span class="lead-tab-count">@followUpOpen</span>
                    }
                </button>
            </li>
        }
        @if (showDealTab)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(defaultTab == "deal" ? "active" : null)" data-bs-toggle="tab" data-bs-target="#lead-tab-deal" data-lead-tab="deal" type="button" role="tab">Deal</button>
            </li>
        }
        @if (documentsPanel != null)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(defaultTab == "docs" ? "active" : null)" data-bs-toggle="tab" data-bs-target="#lead-tab-docs" data-lead-tab="docs" type="button" role="tab">
                    Documents
                    @if (docCount > 0)
                    {
                        <span class="lead-tab-count">@docCount</span>
                    }
                </button>
            </li>
        }
        @if (partnerAssignPanel != null)
        {
            <li class="nav-item" role="presentation">
                <button class="nav-link @(defaultTab == "partner" ? "active" : null)" data-bs-toggle="tab" data-bs-target="#lead-tab-partner" data-lead-tab="partner" type="button" role="tab">
                    Partner
                    @if (partnerAssignPanel.IsAssigned)
                    {
                        <span class="lead-tab-count">1</span>
                    }
                </button>
            </li>
        }
    </ul>

    <div class="tab-content">
        <div class="tab-pane fade lead-tab-pane @(defaultTab == "notes" ? "show active" : null)" id="lead-tab-notes" role="tabpanel">
            <div class="lead-notes-card">
                <div class="lead-notes-header">
                    <div>
                        <h5><i class="bi bi-journal-text me-2"></i>Call log</h5>
                        <p>Demo notes and conversation history. Scheduled reminders live in Follow-ups.</p>
                    </div>
                </div>
                <div class="lead-notes-body">
                    @if (status != LeadPipeline.Rejected)
                    {
                        <form asp-action="AddDemoRequestNote" method="post" class="lead-note-form">
                            @Html.AntiForgeryToken()
                            <input type="hidden" name="id" value="@Model.Id" />
                            <div class="lead-note-composer">
                                <div class="lead-note-composer-icon"><i class="bi bi-pencil-square"></i></div>
                                <div class="lead-note-composer-fields">
                                    <textarea name="noteText" class="form-control lead-note-input" rows="2" placeholder="Type demo summary or client feedback..." required></textarea>
                                    <button type="submit" class="btn lead-note-submit"><i class="bi bi-plus-lg"></i> Add</button>
                                </div>
                            </div>
                        </form>
                    }
                    else
                    {
                        <div class="lead-rejected-banner">
                            <i class="bi bi-slash-circle"></i>
                            <div>
                                <strong>Lead rejected</strong>
                                <p>Further conversations and emails are disabled for this request.</p>
                            </div>
                        </div>
                    }

                    <div class="lead-history-title"><i class="bi bi-clock-history me-2"></i>History</div>
                    @if (Model.Notes != null && Model.Notes.Any())
                    {
                        <div class="timeline">
                            @foreach (var note in Model.Notes)
                            {
                                <div class="timeline-item @(note.IsPostConfirmation ? "post-confirmation" : "")">
                                    <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                        <div class="d-flex align-items-center gap-2 flex-wrap">
                                            <span class="badge bg-secondary">@note.CreatedAt.ToString("MMM dd, yyyy")</span>
                                            @if (note.IsPostConfirmation)
                                            {
                                                <span class="badge bg-success">Post-confirmation</span>
                                            }
                                        </div>
                                        <small class="text-muted">@note.CreatedAt.ToString("hh:mm tt")</small>
                                    </div>
                                    <div class="note-box @(note.IsPostConfirmation ? "note-box-success" : "")">@note.NoteText</div>
                                </div>
                            }
                        </div>
                    }
                    else
                    {
                        <div class="lead-empty-notes">
                            <i class="bi bi-journal-x"></i>
                            <h6>No notes yet</h6>
                            <p>Demo notes and call logs will appear here.</p>
                        </div>
                    }
                </div>
            </div>
        </div>

        @if (followUpsPanel != null)
        {
            <div class="tab-pane fade lead-tab-pane @(defaultTab == "followups" ? "show active" : null)" id="lead-tab-followups" role="tabpanel">
                <p class="lead-tab-hint">Schedule the next reminder. This is separate from the call log.</p>
                <partial name="_LeadFollowUpsPanel" model="followUpsPanel" />
            </div>
        }

        @if (showDealTab)
        {
            <div class="tab-pane fade lead-tab-pane @(defaultTab == "deal" ? "show active" : null)" id="lead-tab-deal" role="tabpanel">
                <partial name="_LeadDealPanel" model="dealPanel" />
            </div>
        }

        @if (documentsPanel != null)
        {
            <div class="tab-pane fade lead-tab-pane @(defaultTab == "docs" ? "show active" : null)" id="lead-tab-docs" role="tabpanel">
                <partial name="_LeadDocumentsPanel" model="documentsPanel" />
            </div>
        }

        @if (partnerAssignPanel != null)
        {
            <div class="tab-pane fade lead-tab-pane @(defaultTab == "partner" ? "show active" : null)" id="lead-tab-partner" role="tabpanel">
                <partial name="_LeadPartnerAssignPanel" model="partnerAssignPanel" />
            </div>
        }
    </div>
</div>

<partial name="_LeadWorkspaceScripts" />

<div class="modal fade" id="emailModal" tabindex="-1" aria-labelledby="emailModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-lg modal-dialog-centered">
        <div class="modal-content lead-email-modal">
            <form asp-action="SendEmail" method="post">
                <div class="modal-header">
                    <div class="d-flex align-items-center gap-3">
                        <div class="lead-email-icon"><i class="bi bi-envelope-paper"></i></div>
                        <div>
                            <h5 class="modal-title mb-0" id="emailModalLabel">Compose email</h5>
                            <small class="text-muted">Reply to @Model.Name</small>
                        </div>
                    </div>
                    <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                </div>
                <div class="modal-body">
                    <input type="hidden" name="returnUrl" value="/Admin/DemoRequestDetails/@Model.Id" />
                    <input type="hidden" name="toEmail" value="@Model.Email" />
                    <div class="mb-3">
                        <label class="lead-info-label">To</label>
                        <div class="lead-email-to">
                            <span class="lead-avatar sm">@initial</span>
                            <span>@Model.Name &lt;@Model.Email&gt;</span>
                        </div>
                    </div>
                    <div class="mb-3">
                        <label class="lead-info-label">Subject</label>
                        <input type="text" name="subject" class="form-control settings-input" value="Regarding your Demo Request with Softflip Solutions" required />
                    </div>
                    <div class="mb-0">
                        <label class="lead-info-label">Message</label>
                        <textarea name="message" class="form-control custom-textarea" rows="8" required>Hi @Model.Name,

Thank you for booking a demo with Softflip Solutions. We received your request for: @Model.Requirement.

We would love to schedule a quick call to give you a personalized walkthrough of our system. Let us know your availability.

Best regards,
Softflip Solutions Team</textarea>
                    </div>
                </div>
                <div class="modal-footer">
                    <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Discard</button>
                    <button type="submit" class="btn btn-crm-primary"><i class="bi bi-send-fill me-1"></i> Send message</button>
                </div>
            </form>
        </div>
    </div>
</div>
