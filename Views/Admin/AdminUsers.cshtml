@model IEnumerable<SoftflipSolutions.Models.AdminUser>
@using SoftflipSolutions.Models
@using SoftflipSolutions.Services
@{
    ViewData["Title"] = "Admin Users";
    Layout = "_AdminLayout";
    var users = ViewBag.Users as List<AdminUser> ?? Model.ToList();
    var selected = ViewBag.SelectedAdmin as AdminUser;
    var selectedMenus = ViewBag.SelectedMenus as HashSet<string> ?? new HashSet<string>(StringComparer.OrdinalIgnoreCase);
    var catalog = ViewBag.MenuCatalog as IReadOnlyList<AdminMenuItem> ?? AdminMenuCatalog.All;
    var isSuper = selected != null && string.Equals(selected.Role, AdminRoles.SuperAdmin, StringComparison.OrdinalIgnoreCase);
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show"><i class="bi bi-exclamation-triangle-fill me-2"></i>@TempData["ErrorMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="mb-3">
    <h4 class="text-white mb-1">Admin users &amp; menu access</h4>
    <p class="text-muted small mb-0">Same process as employee access — select a user, tick menus, save.</p>
</div>

<div class="glass-card p-4 mb-4">
    <h6 class="mb-3">Add admin user</h6>
    <form asp-action="AddAdminUser" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <div class="col-md-3"><label class="form-label small">Username</label><input name="username" class="form-control settings-input" required /></div>
        <div class="col-md-3"><label class="form-label small">Password</label><input name="password" type="password" class="form-control settings-input" required /></div>
        <div class="col-md-3">
            <label class="form-label small">Role label</label>
            <select name="role" class="form-select settings-input">
                @foreach (var r in AdminRoles.All)
                {
                    <option value="@r">@r</option>
                }
            </select>
        </div>
        <div class="col-md-2"><button type="submit" class="btn btn-crm-primary w-100">Add user</button></div>
    </form>
</div>

<div class="row g-4">
    <div class="col-lg-4">
        <div class="glass-card p-0 overflow-hidden au-users-card">
            <div class="au-users-head">
                <strong>Users</strong>
                <span class="au-users-count">@users.Count</span>
            </div>
            <div class="au-users-list">
                @foreach (var u in users)
                {
                    var isSel = selected?.Id == u.Id;
                    var initial = string.IsNullOrEmpty(u.Username) ? "?" : u.Username.Substring(0, 1).ToUpperInvariant();
                    <a asp-action="AdminUsers" asp-route-id="@u.Id"
                       class="au-user-item @(isSel ? "is-active" : "")">
                        <span class="au-user-avatar" aria-hidden="true">@initial</span>
                        <span class="au-user-meta">
                            <strong>@u.Username</strong>
                            <small>
                                <span class="au-user-role">@u.Role</span>
                                <span class="au-user-dot">·</span>
                                <span class="au-user-status @(u.IsActive ? "on" : "off")">@(u.IsActive ? "Active" : "Off")</span>
                            </small>
                        </span>
                        <i class="bi bi-chevron-right au-user-chevron"></i>
                    </a>
                }
            </div>
        </div>
    </div>

    <div class="col-lg-8">
        @if (selected == null)
        {
            <div class="glass-card p-4 text-muted">Select a user to allot menus.</div>
        }
        else
        {
            <div class="glass-card settings-panel">
                <div class="settings-panel-head">
                    <div class="settings-panel-ico security"><i class="bi bi-person-gear"></i></div>
                    <div>
                        <h4>@selected.Username</h4>
                        <p>Role: @selected.Role · Tick menus this admin can see in the sidebar.</p>
                    </div>
                </div>
                <div class="settings-panel-body">
                    <form asp-action="UpdateAdminAccess" method="post">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="adminUserId" value="@selected.Id" />

                        @if (isSuper)
                        {
                            <div class="alert alert-info">SuperAdmin always has <strong>all menus</strong>. Checkboxes are shown for reference.</div>
                        }

                        @foreach (var menuSection in catalog.GroupBy(m => m.Section))
                        {
                            <div class="settings-section-label mt-2"><i class="bi bi-folder2 me-1"></i> @menuSection.Key</div>
                            <div class="row g-3 mb-3">
                                @foreach (var menu in menuSection)
                                {
                                    var isChecked = isSuper || selectedMenus.Contains(menu.Key);
                                    <div class="col-md-6">
                                        <div class="settings-ssl-card h-100">
                                            <div class="form-check mb-0">
                                                <input class="form-check-input" type="checkbox" name="menus" value="@menu.Key" id="amenu_@menu.Key"
                                                       @(isChecked ? "checked" : "") @(isSuper ? "disabled" : "")>
                                                <label class="form-check-label" for="amenu_@menu.Key">
                                                    <strong><i class="bi @menu.Icon me-1"></i> @menu.Label</strong>
                                                    <span>@menu.Description</span>
                                                </label>
                                            </div>
                                        </div>
                                    </div>
                                }
                            </div>
                        }

                        @if (!isSuper)
                        {
                            <div class="settings-panel-actions">
                                <button type="submit" class="btn btn-crm-primary"><i class="bi bi-save2 me-1"></i> Save menu access</button>
                            </div>
                        }
                    </form>

                    <div class="au-account-actions">
                        <div class="au-account-actions-head">
                            <i class="bi bi-shield-lock"></i>
                            <div>
                                <strong>Account controls</strong>
                                <span>Activate / deactivate this user or set a new password.</span>
                            </div>
                        </div>
                        <div class="au-account-actions-body">
                            @if (selected.Id != 1)
                            {
                                <form asp-action="ToggleAdminUser" method="post" class="au-account-toggle">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@selected.Id" />
                                    <button type="submit" class="btn au-btn-status @(selected.IsActive ? "is-active" : "is-off")">
                                        <i class="bi @(selected.IsActive ? "bi-pause-circle" : "bi-play-circle") me-1"></i>
                                        @(selected.IsActive ? "Deactivate" : "Activate")
                                    </button>
                                </form>
                            }
                            <form asp-action="ResetAdminPassword" method="post" class="au-account-reset">
                                @Html.AntiForgeryToken()
                                <input type="hidden" name="id" value="@selected.Id" />
                                <div class="au-reset-field">
                                    <label class="form-label" for="auNewPassword">New password</label>
                                    <input id="auNewPassword" name="newPassword" type="password" class="form-control settings-input" placeholder="Enter new password" required autocomplete="new-password" />
                                </div>
                                <button type="submit" class="btn au-btn-reset">
                                    <i class="bi bi-key me-1"></i> Reset password
                                </button>
                            </form>
                        </div>
                    </div>
                </div>
            </div>
        }
    </div>
</div>
