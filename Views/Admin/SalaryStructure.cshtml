@model SoftflipSolutions.Models.SalaryStructure
@{
    ViewData["Title"] = "Salary Structure";
    Layout = "_AdminLayout";
    var employee = ViewBag.Employee as SoftflipSolutions.Models.Employee;
}

@if (employee == null) { return; }

<div class="lead-detail-toolbar">
    <a asp-action="EmployeeDetails" asp-route-id="@employee.Id" class="btn btn-lead-back"><i class="bi bi-arrow-left"></i> @employee.FullName</a>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show"><i class="bi bi-check-circle-fill me-2"></i>@TempData["SuccessMessage"]<button type="button" class="btn-close" data-bs-dismiss="alert"></button></div>
}

<div class="glass-card p-4" style="max-width:640px;">
    <h5 class="mb-3">Salary structure — @employee.FullName</h5>
    <form asp-action="SalaryStructure" asp-route-employeeId="@employee.Id" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6"><label class="form-label settings-label">Basic</label><input name="basic" type="number" step="0.01" value="@Model.Basic" class="form-control settings-input" required /></div>
            <div class="col-md-6"><label class="form-label settings-label">HRA</label><input name="hra" type="number" step="0.01" value="@Model.Hra" class="form-control settings-input" required /></div>
            <div class="col-md-6"><label class="form-label settings-label">Allowance</label><input name="allowance" type="number" step="0.01" value="@Model.Allowance" class="form-control settings-input" required /></div>
            <div class="col-md-6"><label class="form-label settings-label">Deductions</label><input name="deductions" type="number" step="0.01" value="@Model.Deductions" class="form-control settings-input" required /></div>
            <div class="col-12"><p class="small text-muted mb-0">Gross: ₹@Model.Gross.ToString("N2") · Net: ₹@Model.Net.ToString("N2")</p></div>
        </div>
        <div class="settings-panel-actions mt-4">
            <button type="submit" class="btn btn-crm-primary">Save structure</button>
        </div>
    </form>
    <hr class="my-4" style="border-color:rgba(255,255,255,0.1);" />
    <h6>Generate payslip</h6>
    <form asp-action="GeneratePayslip" method="post" class="row g-2 align-items-end">
        @Html.AntiForgeryToken()
        <input type="hidden" name="employeeId" value="@employee.Id" />
        <div class="col-md-4"><label class="form-label small">Year</label><input name="year" type="number" value="@DateTime.Today.Year" class="form-control settings-input" /></div>
        <div class="col-md-4"><label class="form-label small">Month</label><input name="month" type="number" min="1" max="12" value="@DateTime.Today.Month" class="form-control settings-input" /></div>
        <div class="col-md-4"><button type="submit" class="btn btn-outline-info w-100">Generate</button></div>
    </form>
</div>
