@model SoftflipSolutions.Models.ServiceCatalog
@{
    ViewData["Title"] = "Add Service";
    Layout = "_AdminLayout";
    var serviceNames = ViewBag.ServiceNameOptions as string[] ?? Array.Empty<string>();
}

<div class="glass-card p-4">
    <div class="mb-4">
        <a asp-action="Services" class="btn btn-lead-back mb-3"><i class="bi bi-arrow-left"></i> Back</a>
        <h4 class="mb-1" style="color:#152238">Add Service</h4>
        <p class="text-muted small mb-0">Create service with budget &amp; commission. Admin / User / Franchise panels are added automatically — upload features on the next page.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="AddService" method="post">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="Name"></label>
                <select asp-for="Name" class="form-control settings-input" required>
                    <option value="">Select service name</option>
                    @foreach (var item in serviceNames)
                    {
                        <option value="@item">@item</option>
                    }
                </select>
            </div>
            <div class="col-md-3">
                <label class="lead-info-label" asp-for="Budget"></label>
                <input asp-for="Budget" type="number" class="form-control settings-input" step="0.01" min="0.01" required placeholder="e.g. 50000" />
            </div>
            <div class="col-md-3">
                <label class="lead-info-label" asp-for="Commission"></label>
                <input asp-for="Commission" type="number" class="form-control settings-input" step="0.01" min="0" max="100" required placeholder="e.g. 10" />
                <!-- <div class="form-text text-muted">% of budget — proposal PDF mein nahi.</div> -->
            </div>
            <div class="col-12">
                <label class="lead-info-label" asp-for="Description"></label>
                <textarea asp-for="Description" class="form-control settings-input" rows="3" maxlength="2000" placeholder="Short description (optional)"></textarea>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-check2-circle me-1"></i> Create Service</button>
        </div>
    </form>
</div>
