@{
    ViewData["Title"] = "Dashboard";
    Layout = "_AdminLayout";
    var totalEnquiries = (int)(ViewBag.TotalEnquiries ?? 0);
    var totalDemos = (int)(ViewBag.TotalDemoRequests ?? 0);
    var totalLeads = (int)(ViewBag.TotalClientLeads ?? 0);
    var totalPipeline = totalEnquiries + totalDemos + totalLeads;
    var openInvoices = (int)(ViewBag.OpenInvoices ?? 0);
    var outstanding = (decimal)(ViewBag.OutstandingBalance ?? 0m);
    var overdueFollowUps = (int)(ViewBag.OverdueFollowUps ?? 0);
    var expiringProposals = (int)(ViewBag.ExpiringProposals ?? 0);
    var pendingCommission = (decimal)(ViewBag.PendingCommission ?? 0m);
}

<div class="page-toolbar">
    <h2>Dashboard</h2>
    <div class="toolbar-actions">
        <span class="toolbar-chip">
            <i class="bi bi-calendar3"></i>
            @DateTime.Now.AddDays(-30).ToString("dd MMM yy") - @DateTime.Now.ToString("dd MMM yy")
        </span>
        <button type="button" class="toolbar-chip" onclick="location.reload()" title="Refresh">
            <i class="bi bi-arrow-clockwise"></i>
        </button>
    </div>
</div>

<div class="welcome-banner">
    <div class="welcome-content">
        <h2>Welcome Back, Admin</h2>
        <p>@(totalLeads + totalEnquiries) new leads in your pipeline. Keep the momentum going.</p>
    </div>
    <div class="welcome-actions">
        <a asp-action="ClientLeads" class="btn btn-crm-primary">External Clients</a>
        <a asp-action="AddClientLead" class="btn btn-crm-outline">Add Client</a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card accent-red">
            <div class="stat-card-top">
                <div class="stat-label">Total Enquiries</div>
                <div class="stat-icon primary"><i class="bi bi-building"></i></div>
            </div>
            <div class="stat-value">@totalEnquiries</div>
            <div class="stat-trend up"><i class="bi bi-arrow-up"></i> From website forms</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card accent-green">
            <div class="stat-card-top">
                <div class="stat-label">Demo Requests</div>
                <div class="stat-icon success"><i class="bi bi-laptop"></i></div>
            </div>
            <div class="stat-value">@totalDemos</div>
            <div class="stat-trend up"><i class="bi bi-arrow-up"></i> Product demos</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card accent-yellow">
            <div class="stat-card-top">
                <div class="stat-label">External Clients</div>
                <div class="stat-icon warning"><i class="bi bi-people"></i></div>
            </div>
            <div class="stat-value">@totalLeads</div>
            <div class="stat-trend up"><i class="bi bi-arrow-up"></i> WhatsApp / Just Dial / IndiaMART</div>
        </div>
    </div>
    <div class="col-sm-6 col-xl-3">
        <div class="stat-card accent-blue">
            <div class="stat-card-top">
                <div class="stat-label">Pipeline Total</div>
                <div class="stat-icon info"><i class="bi bi-graph-up-arrow"></i></div>
            </div>
            <div class="stat-value">@totalPipeline</div>
            <div class="stat-trend up"><i class="bi bi-arrow-up"></i> All active sources</div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Invoices" class="text-decoration-none">
            <div class="stat-card accent-yellow">
                <div class="stat-card-top">
                    <div class="stat-label">Open invoices</div>
                    <div class="stat-icon warning"><i class="bi bi-receipt"></i></div>
                </div>
                <div class="stat-value">@openInvoices</div>
                <div class="stat-trend"><i class="bi bi-currency-rupee"></i> ₹@outstanding.ToString("N0") due</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="FollowUps" class="text-decoration-none">
            <div class="stat-card accent-red">
                <div class="stat-card-top">
                    <div class="stat-label">Overdue follow-ups</div>
                    <div class="stat-icon primary"><i class="bi bi-alarm"></i></div>
                </div>
                <div class="stat-value">@overdueFollowUps</div>
                <div class="stat-trend"><i class="bi bi-arrow-right"></i> Open reminders</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="Proposals" class="text-decoration-none">
            <div class="stat-card accent-blue">
                <div class="stat-card-top">
                    <div class="stat-label">Expiring proposals</div>
                    <div class="stat-icon info"><i class="bi bi-hourglass-split"></i></div>
                </div>
                <div class="stat-value">@expiringProposals</div>
                <div class="stat-trend"><i class="bi bi-calendar3"></i> Next 3 days</div>
            </div>
        </a>
    </div>
    <div class="col-sm-6 col-xl-3">
        <a asp-action="CommissionTracker" class="text-decoration-none">
            <div class="stat-card accent-green">
                <div class="stat-card-top">
                    <div class="stat-label">Pending commission</div>
                    <div class="stat-icon success"><i class="bi bi-percent"></i></div>
                </div>
                <div class="stat-value" style="font-size:1.35rem;">₹@pendingCommission.ToString("N0")</div>
                <div class="stat-trend"><i class="bi bi-arrow-right"></i> Tracker</div>
            </div>
        </a>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-lg-4">
        <div class="dash-list-card">
            <div class="dash-list-header">
                <h5>Quick Actions</h5>
            </div>
            <div class="p-3">
                <div class="d-flex flex-column gap-2">
                    <a asp-action="Enquiries" class="quick-action-btn">
                        <i class="bi bi-inbox"></i>
                        <div>
                            <div class="fw-semibold">View Enquiries</div>
                            <div class="small text-muted">Website form submissions</div>
                        </div>
                    </a>
                    <a asp-action="FollowUps" class="quick-action-btn">
                        <i class="bi bi-alarm"></i>
                        <div>
                            <div class="fw-semibold">Follow-ups</div>
                            <div class="small text-muted">Overdue &amp; upcoming calls</div>
                        </div>
                    </a>
                    <a asp-action="Activity" class="quick-action-btn">
                        <i class="bi bi-activity"></i>
                        <div>
                            <div class="fw-semibold">Activity timeline</div>
                            <div class="small text-muted">Notes, deals &amp; payments</div>
                        </div>
                    </a>
                    <a asp-action="AddClientLead" class="quick-action-btn">
                        <i class="bi bi-person-plus"></i>
                        <div>
                            <div class="fw-semibold">Add External Client</div>
                            <div class="small text-muted">WhatsApp, Just Dial, IndiaMART</div>
                        </div>
                    </a>
                    <a asp-action="Settings" class="quick-action-btn">
                        <i class="bi bi-sliders"></i>
                        <div>
                            <div class="fw-semibold">Platform Settings</div>
                            <div class="small text-muted">SMTP &amp; security</div>
                        </div>
                    </a>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="dash-list-card">
            <div class="dash-list-header">
                <h5>Lead Sources</h5>
                <a asp-action="ClientLeads" class="btn-view-all">View All</a>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar green"><i class="bi bi-whatsapp"></i></div>
                <div class="dash-list-meta">
                    <p class="name">WhatsApp</p>
                    <p class="sub">Direct chat enquiries</p>
                </div>
                <div class="dash-list-right">
                    <p class="tag">Active</p>
                </div>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar yellow"><i class="bi bi-telephone"></i></div>
                <div class="dash-list-meta">
                    <p class="name">Just Dial</p>
                    <p class="sub">Directory leads</p>
                </div>
                <div class="dash-list-right">
                    <p class="tag">Active</p>
                </div>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar red"><i class="bi bi-shop"></i></div>
                <div class="dash-list-meta">
                    <p class="name">IndiaMART</p>
                    <p class="sub">B2B marketplace</p>
                </div>
                <div class="dash-list-right">
                    <p class="tag">Active</p>
                </div>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar blue"><i class="bi bi-globe"></i></div>
                <div class="dash-list-meta">
                    <p class="name">Website</p>
                    <p class="sub">Enquiry &amp; demo forms</p>
                </div>
                <div class="dash-list-right">
                    <p class="tag">Active</p>
                </div>
            </div>
        </div>
    </div>

    <div class="col-lg-4">
        <div class="dash-list-card">
            <div class="dash-list-header">
                <h5>Pipeline</h5>
                <a asp-action="ConfirmedClients" class="btn-view-all">View All</a>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar yellow"><i class="bi bi-hourglass-split"></i></div>
                <div class="dash-list-meta">
                    <p class="name">Pending Leads</p>
                    <p class="sub">Needs follow-up</p>
                </div>
                <div class="dash-list-right">
                    <p class="amount" style="color: var(--warning);">Review</p>
                </div>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar green"><i class="bi bi-check2-circle"></i></div>
                <div class="dash-list-meta">
                    <p class="name">Confirmed Clients</p>
                    <p class="sub">Won / converted</p>
                </div>
                <div class="dash-list-right">
                    <a asp-action="ConfirmedClients" class="tag" style="color: var(--info);">Open</a>
                </div>
            </div>
            <div class="dash-list-item">
                <div class="dash-list-avatar red"><i class="bi bi-x-circle"></i></div>
                <div class="dash-list-meta">
                    <p class="name">Rejected Leads</p>
                    <p class="sub">Closed / not a fit</p>
                </div>
                <div class="dash-list-right">
                    <a asp-action="RejectedClients" class="tag" style="color: var(--info);">Open</a>
                </div>
            </div>
            <div class="p-3">
                <div class="system-status mb-0">
                    <div class="d-flex align-items-center mb-1">
                        <i class="bi bi-hdd-network text-success fs-5 me-2"></i>
                        <strong>System Healthy</strong>
                    </div>
                    <p class="text-muted small mb-0">Database connected. Softflip OS is running normally.</p>
                </div>
            </div>
        </div>
    </div>
</div>

<div class="row g-3 mb-4">
    <div class="col-12">
        <div class="dash-list-card">
            <div class="dash-list-header">
                <h5>Invoice totals (last 6 months)</h5>
            </div>
            <div class="p-3">
                <canvas id="invoiceChart" height="80"></canvas>
            </div>
        </div>
    </div>
</div>

@section Scripts {
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.1/dist/chart.umd.min.js"></script>
<script>
    (async function () {
        try {
            const res = await fetch('@Url.Action("DashboardChartsJson")');
            const data = await res.json();
            const ctx = document.getElementById('invoiceChart');
            if (!ctx || !data.labels) return;
            new Chart(ctx, {
                type: 'bar',
                data: {
                    labels: data.labels,
                    datasets: [{
                        label: 'Invoice amount (₹)',
                        data: data.totals,
                        backgroundColor: 'rgba(0, 180, 220, 0.45)',
                        borderColor: 'rgba(0, 180, 220, 0.9)',
                        borderWidth: 1
                    }]
                },
                options: {
                    responsive: true,
                    plugins: { legend: { display: false } },
                    scales: {
                        y: { beginAtZero: true, ticks: { callback: v => '₹' + v.toLocaleString() } }
                    }
                }
            });
        } catch (_) {}
    })();
</script>
}
