@model SoftflipSolutions.Models.ClientLead
@using SoftflipSolutions.Models
@{
    ViewData["Title"] = "Client Lead Details";
    Layout = "_AdminLayout";
    var waNumber = Model.Mobile.Replace("+", "").Replace(" ", "").Replace("-", "");
    var status = string.IsNullOrEmpty(Model.Status) ? LeadPipeline.Pending : Model.Status;
    var statusClass = LeadPipeline.BadgeClass(status);
    var statusIcon = LeadPipeline.BadgeIcon(status);
    var statusLabel = LeadPipeline.DisplayName(status);
    var dealPanel = ViewBag.DealPanel as SoftflipSolutions.ViewModels.LeadDealPanelViewModel;
}

<div class="lead-detail-toolbar">
    <a asp-action="ClientLeads" class="btn btn-lead-back">
        <i class="bi bi-arrow-left"></i> Back to External Clients
    </a>
    <div class="lead-detail-meta">
        <span><i class="bi bi-calendar3"></i> @Model.CreatedAt.ToString("dd MMM yyyy, hh:mm tt")</span>
        <span class="badge bg-@statusClass"><i class="bi @statusIcon me-1"></i>@statusLabel</span>
    </div>
</div>

@if (status == LeadPipeline.Pending)
{
    <div class="lead-action-bar mb-4">
        <div class="lead-action-copy">
            <div class="lead-action-icon warning"><i class="bi bi-exclamation-circle"></i></div>
            <div>
                <h5>Decision pending</h5>
                <p>Finalize this lead after speaking with the client.</p>
            </div>
        </div>
        <div class="lead-action-buttons">
            <form asp-action="UpdateClientLeadStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@LeadPipeline.Confirmed" />
                <button type="submit" class="btn btn-lead-success"><i class="bi bi-check2-circle"></i> Confirm</button>
            </form>
            <form asp-action="UpdateClientLeadStatus" method="post">
                @Html.AntiForgeryToken()
                <input type="hidden" name="id" value="@Model.Id" />
                <input type="hidden" name="status" value="@LeadPipeline.Rejected" />
                <button type="submit" class="btn btn-lead-danger" onclick="return confirm('Reject this lead?');"><i class="bi bi-x-circle"></i> Reject</button>
            </form>
        </div>
    </div>
}

@if (dealPanel != null)
{
    <partial name="_LeadDealPanel" model="dealPanel" />
}

@{
    var documentsPanel = ViewBag.DocumentsPanel as SoftflipSolutions.ViewModels.LeadDocumentsPanelViewModel;
}
@if (documentsPanel != null)
{
    <partial name="_LeadDocumentsPanel" model="documentsPanel" />
}

@{
    var followUpsPanel = ViewBag.FollowUpsPanel as SoftflipSolutions.ViewModels.LeadFollowUpsPanelViewModel;
}
@if (followUpsPanel != null)
{
    <partial name="_LeadFollowUpsPanel" model="followUpsPanel" />
}

@{
    var duplicates = ViewBag.DuplicateLeads as IEnumerable<SoftflipSolutions.ViewModels.DuplicateLeadMatch>;
}
@if (duplicates != null)
{
    <partial name="_DuplicateLeadsAlert" model="duplicates" />
}

<div class="row g-4">
    <div class="col-xl-4 col-lg-5">
        <div class="lead-profile-card">
            <div class="lead-profile-top">
                <div class="lead-avatar">@Model.Name.Substring(0, 1).ToUpper()</div>
                <div>
                    <h3>@Model.Name</h3>
                    <span class="badge bg-@statusClass"><i class="bi @statusIcon me-1"></i>@statusLabel</span>
                </div>
            </div>

            <div class="lead-profile-body">
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-broadcast"></i></div>
                    <div>
                        <div class="lead-info-label">Source</div>
                        <span class="badge bg-info">@Model.Source</span>
                    </div>
                </div>
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-telephone"></i></div>
                    <div>
                        <div class="lead-info-label">Mobile / WhatsApp</div>
                        <a href="tel:@Model.Mobile">@Model.Mobile</a>
                        <a href="https://wa.me/@waNumber" target="_blank" class="btn btn-sm btn-success ms-2 rounded-pill px-3"><i class="bi bi-whatsapp"></i></a>
                    </div>
                </div>
                @if (!string.IsNullOrWhiteSpace(Model.Email))
                {
                    <div class="lead-info-row">
                        <div class="lead-info-icon"><i class="bi bi-envelope"></i></div>
                        <div>
                            <div class="lead-info-label">Email</div>
                            <a href="mailto:@Model.Email">@Model.Email</a>
                        </div>
                    </div>
                }
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-tag"></i></div>
                    <div>
                        <div class="lead-info-label">Requirement</div>
                        <span>@Model.Requirement</span>
                    </div>
                </div>
                <div class="lead-info-row">
                    <div class="lead-info-icon"><i class="bi bi-cash-stack"></i></div>
                    <div>
                        <div class="lead-info-label">Budget</div>
                        <span>@(string.IsNullOrWhiteSpace(Model.Budget) ? "Not specified" : Model.Budget)</span>
                    </div>
                </div>

                @if (status != LeadPipeline.Rejected && !string.IsNullOrWhiteSpace(Model.Email))
                {
                    <button type="button" class="btn btn-lead-email" data-bs-toggle="modal" data-bs-target="#emailModal">
                        <i class="bi bi-envelope-paper"></i> Compose Email
                    </button>
                }
                @{
                    var waDigits = new string((Model.Mobile ?? "").Where(char.IsDigit).ToArray());
                    var templates = ViewBag.MessageTemplates as IEnumerable<SoftflipSolutions.Models.MessageTemplate> ?? Enumerable.Empty<SoftflipSolutions.Models.MessageTemplate>();
                    var waTemplates = templates.Where(t => t.Channel == "WhatsApp").ToList();
                }
                @if (status != LeadPipeline.Rejected && waDigits.Length >= 8 && waTemplates.Any())
                {
                    <div class="dropdown mt-2">
                        <button class="btn btn-success w-100 rounded-pill dropdown-toggle" type="button" data-bs-toggle="dropdown">
                            <i class="bi bi-whatsapp me-1"></i> WhatsApp template
                        </button>
                        <ul class="dropdown-menu dropdown-menu-dark w-100">
                            @foreach (var t in waTemplates)
                            {
                                var body = t.Body
                                    .Replace("{{Name}}", Model.Name, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Requirement}}", Model.Requirement, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Phone}}", Model.Mobile, StringComparison.OrdinalIgnoreCase)
                                    .Replace("{{Email}}", Model.Email ?? "", StringComparison.OrdinalIgnoreCase);
                                var waUrl = $"https://wa.me/{waDigits}?text={Uri.EscapeDataString(body)}";
                                <li><a class="dropdown-item" href="@waUrl" target="_blank" rel="noopener">@t.Name</a></li>
                            }
                        </ul>
                    </div>
                }
            </div>
        </div>
    </div>

    <div class="col-xl-8 col-lg-7">
        <div class="lead-notes-card">
            <div class="lead-notes-header">
                <div>
                    <h5><i class="bi bi-journal-text me-2"></i>Call logs &amp; notes</h5>
                    <p>Track conversations and follow-ups for this lead.</p>
                </div>
            </div>
            <div class="lead-notes-body">
                @if (status != LeadPipeline.Rejected)
                {
                    <form asp-action="AddClientLeadNote" method="post" class="lead-note-form">
                        @Html.AntiForgeryToken()
                        <input type="hidden" name="id" value="@Model.Id" />
                        <div class="lead-note-composer">
                            <div class="lead-note-composer-icon"><i class="bi bi-pencil-square"></i></div>
                            <div class="lead-note-composer-fields">
                                <textarea name="noteText" class="form-control lead-note-input" rows="2" placeholder="Add call summary or next step..." required></textarea>
                                <button type="submit" class="btn lead-note-submit"><i class="bi bi-plus-lg"></i> Add</button>
                            </div>
                        </div>
                    </form>
                }
                else
                {
                    <div class="lead-rejected-banner">
                        <i class="bi bi-slash-circle"></i>
                        <div>
                            <strong>Lead rejected</strong>
                            <p>Further notes are disabled for this lead.</p>
                        </div>
                    </div>
                }

                <div class="lead-history-title"><i class="bi bi-clock-history me-2"></i>History</div>
                @if (Model.Notes != null && Model.Notes.Any())
                {
                    <div class="timeline">
                        @foreach (var note in Model.Notes)
                        {
                            <div class="timeline-item @(note.IsPostConfirmation ? "post-confirmation" : "")">
                                <div class="d-flex justify-content-between align-items-center mb-2 flex-wrap gap-2">
                                    <div class="d-flex align-items-center gap-2 flex-wrap">
                                        <span class="badge bg-secondary">@note.CreatedAt.ToString("MMM dd, yyyy")</span>
                                        @if (note.IsPostConfirmation)
                                        {
                                            <span class="badge bg-success">Post-confirmation</span>
                                        }
                                    </div>
                                    <small class="text-muted">@note.CreatedAt.ToString("hh:mm tt")</small>
                                </div>
                                <div class="note-box @(note.IsPostConfirmation ? "note-box-success" : "")">@note.NoteText</div>
                            </div>
                        }
                    </div>
                }
                else
                {
                    <div class="lead-empty-notes">
                        <i class="bi bi-journal-x"></i>
                        <h6>No notes yet</h6>
                        <p>Call logs will appear here.</p>
                    </div>
                }
            </div>
        </div>
    </div>
</div>

@if (!string.IsNullOrWhiteSpace(Model.Email))
{
    <div class="modal fade" id="emailModal" tabindex="-1" aria-hidden="true">
        <div class="modal-dialog modal-lg modal-dialog-centered">
            <div class="modal-content lead-email-modal">
                <form asp-action="SendEmail" method="post">
                    <div class="modal-header">
                        <div class="d-flex align-items-center gap-3">
                            <div class="lead-email-icon"><i class="bi bi-envelope-paper"></i></div>
                            <div>
                                <h5 class="modal-title mb-0">Compose email</h5>
                                <small class="text-muted">Reply to @Model.Name</small>
                            </div>
                        </div>
                        <button type="button" class="btn-close" data-bs-dismiss="modal"></button>
                    </div>
                    <div class="modal-body">
                        <input type="hidden" name="returnUrl" value="/Admin/ClientLeadDetails/@Model.Id" />
                        <input type="hidden" name="toEmail" value="@Model.Email" />
                        @{
                            var emailTemplates = (ViewBag.MessageTemplates as IEnumerable<SoftflipSolutions.Models.MessageTemplate> ?? Enumerable.Empty<SoftflipSolutions.Models.MessageTemplate>())
                                .Where(t => t.Channel == "Email").ToList();
                        }
                        @if (emailTemplates.Any())
                        {
                            <div class="mb-3">
                                <label class="lead-info-label">Template</label>
                                <select class="form-select settings-input" id="emailTemplateSelect">
                                    <option value="">— Choose template —</option>
                                    @foreach (var t in emailTemplates)
                                    {
                                        var subj = (t.Subject ?? "")
                                            .Replace("{{Name}}", Model.Name, StringComparison.OrdinalIgnoreCase)
                                            .Replace("{{Requirement}}", Model.Requirement, StringComparison.OrdinalIgnoreCase);
                                        var body = t.Body
                                            .Replace("{{Name}}", Model.Name, StringComparison.OrdinalIgnoreCase)
                                            .Replace("{{Requirement}}", Model.Requirement, StringComparison.OrdinalIgnoreCase)
                                            .Replace("{{Phone}}", Model.Mobile, StringComparison.OrdinalIgnoreCase)
                                            .Replace("{{Email}}", Model.Email ?? "", StringComparison.OrdinalIgnoreCase);
                                        <option value="@t.Id" data-subject="@subj" data-body="@body">@t.Name</option>
                                    }
                                </select>
                            </div>
                        }
                        <div class="mb-3">
                            <label class="lead-info-label">Subject</label>
                            <input type="text" name="subject" id="emailSubject" class="form-control settings-input" value="Regarding your enquiry with Softflip Solutions" required />
                        </div>
                        <div class="mb-0">
                            <label class="lead-info-label">Message</label>
                            <textarea name="message" id="emailMessage" class="form-control custom-textarea" rows="8" required>Hi @Model.Name,

Thank you for your interest via @Model.Source regarding: @Model.Requirement.

We would love to schedule a call to discuss this further. Please let us know a convenient time.

Best regards,
Softflip Solutions Team</textarea>
                        </div>
                    </div>
                    <div class="modal-footer">
                        <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Discard</button>
                        <button type="submit" class="btn btn-crm-primary"><i class="bi bi-send-fill me-1"></i> Send</button>
                    </div>
                </form>
            </div>
        </div>
    </div>
}
<script>
    (function () {
        const sel = document.getElementById('emailTemplateSelect');
        if (!sel) return;
        sel.addEventListener('change', () => {
            const opt = sel.options[sel.selectedIndex];
            if (!opt || !opt.value) return;
            const subj = document.getElementById('emailSubject');
            const msg = document.getElementById('emailMessage');
            if (subj) subj.value = opt.getAttribute('data-subject') || '';
            if (msg) msg.value = opt.getAttribute('data-body') || '';
        });
    })();
</script>
