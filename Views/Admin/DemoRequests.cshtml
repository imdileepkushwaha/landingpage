@model IEnumerable<SoftflipSolutions.Models.DemoRequest>
@{
    ViewData["Title"] = "Demo Requests";
    Layout = "_AdminLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}
@if (TempData["ErrorMessage"] != null)
{
    <div class="alert alert-danger alert-dismissible fade show" role="alert">
        <i class="bi bi-exclamation-triangle-fill me-2"></i> @TempData["ErrorMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-0 overflow-hidden">
    <div class="p-4 border-bottom d-flex flex-wrap gap-2 justify-content-between align-items-center admin-table-header" style="border-color: rgba(255,255,255,0.08) !important;">
        <h5 class="mb-0 text-white">Pending Demos</h5>
        <div class="d-flex align-items-center gap-2">
            <button type="button" class="btn btn-sm btn-outline-danger d-none" id="bulkDeleteDemosBtn" data-bs-toggle="modal" data-bs-target="#bulkDeleteDemoModal">
                <i class="bi bi-trash3 me-1"></i> Delete selected (<span id="bulkDemoCount">0</span>)
            </button>
            <span class="badge bg-warning bg-opacity-25 text-warning border border-warning border-opacity-50 px-3 py-2 rounded-pill">Total: @Model.Count()</span>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-borderless mb-0 align-middle" id="demosTable">
            <thead>
                <tr>
                    <th style="width:42px;">
                        <input type="checkbox" class="form-check-input" id="selectAllDemos" title="Select all" @(Model.Any() ? "" : "disabled") />
                    </th>
                    <th>Requested On</th>
                    <th>Prospect Name</th>
                    <th>Company Name</th>
                    <th>Contact Info</th>
                    <th>Requirement & Message</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td>
                            <input type="checkbox" class="form-check-input demo-row-check" value="@item.Id" />
                        </td>
                        <td class="text-muted small">
                            <i class="bi bi-calendar-event me-1"></i> @item.CreatedAt.ToString("MMM dd, yyyy HH:mm")
                        </td>
                        <td class="fw-bold">
                            <div class="d-flex align-items-center">
                                <div class="bg-primary bg-opacity-10 text-primary rounded-circle d-flex align-items-center justify-content-center me-3 admin-avatar">
                                    @item.Name.Substring(0, 1).ToUpper()
                                </div>
                                @item.Name
                            </div>
                        </td>
                        <td><span class="fw-medium text-white-50">@item.CompanyName</span></td>
                        <td>
                            <div class="d-flex flex-column">
                                <a href="mailto:@item.Email" class="text-info text-decoration-none small"><i class="bi bi-envelope me-1"></i> @item.Email</a>
                                <span class="text-muted small mt-1"><i class="bi bi-telephone me-1"></i> @item.Phone</span>
                            </div>
                        </td>
                        <td class="admin-msg-col">
                            <div class="mb-1">
                                <span class="badge bg-secondary">@item.Requirement</span>
                            </div>
                            <div class="text-truncate text-muted small" style="max-width: 250px;" title="@item.Message">
                                @item.Message
                            </div>
                        </td>
                        <td class="text-end">
                            <div class="admin-row-actions">
                                <a asp-action="DemoRequestDetails" asp-route-id="@item.Id" class="btn btn-icon-action" title="View"><i class="bi bi-eye"></i></a>
                                <button type="button"
                                        class="btn btn-icon-action danger"
                                        title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deleteDemoModal"
                                        data-demo-id="@item.Id"
                                        data-demo-name="@item.Name">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5">
                            <div class="text-muted mb-2"><i class="bi bi-calendar-x fs-1"></i></div>
                            <h6>No demo requests found</h6>
                            <p class="small">Leads requesting a demo will populate this list.</p>
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deleteDemoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-confirm-modal">
            <div class="modal-header border-0 pb-0">
                <div class="admin-confirm-ico"><i class="bi bi-trash3"></i></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title mb-2">Delete demo request?</h5>
                <p class="mb-0 text-muted">
                    This will permanently remove <strong id="deleteDemoName">this request</strong>, including notes, documents, proposals, and invoices. This cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteDemoRequest" method="post">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deleteDemoId" value="" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

<div class="modal fade" id="bulkDeleteDemoModal" tabindex="-1" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-confirm-modal">
            <div class="modal-header border-0 pb-0">
                <div class="admin-confirm-ico"><i class="bi bi-trash3"></i></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title mb-2">Delete selected demo requests?</h5>
                <p class="mb-0 text-muted">
                    Permanently delete <strong id="bulkDemoConfirmCount">0</strong> demo request(s) and related notes, documents, proposals, and invoices.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="BulkDeleteDemoRequests" method="post" id="bulkDeleteDemoForm">
                    @Html.AntiForgeryToken()
                    <div id="bulkDemoIds"></div>
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete selected</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('deleteDemoModal');
            if (modal) {
                modal.addEventListener('show.bs.modal', function (event) {
                    const btn = event.relatedTarget;
                    if (!btn) return;
                    document.getElementById('deleteDemoId').value = btn.getAttribute('data-demo-id') || '';
                    document.getElementById('deleteDemoName').textContent = btn.getAttribute('data-demo-name') || 'this request';
                });
            }

            const selectAll = document.getElementById('selectAllDemos');
            const checks = () => Array.from(document.querySelectorAll('.demo-row-check'));
            const bulkBtn = document.getElementById('bulkDeleteDemosBtn');
            const countEl = document.getElementById('bulkDemoCount');
            const confirmCount = document.getElementById('bulkDemoConfirmCount');
            const idsBox = document.getElementById('bulkDemoIds');

            function syncBulk() {
                const selected = checks().filter(c => c.checked);
                const n = selected.length;
                countEl.textContent = n;
                confirmCount.textContent = n;
                bulkBtn.classList.toggle('d-none', n === 0);
                if (selectAll) {
                    const all = checks();
                    selectAll.checked = all.length > 0 && selected.length === all.length;
                    selectAll.indeterminate = selected.length > 0 && selected.length < all.length;
                }
                idsBox.innerHTML = selected.map(c => '<input type="hidden" name="ids" value="' + c.value + '" />').join('');
            }

            if (selectAll) {
                selectAll.addEventListener('change', function () {
                    checks().forEach(c => { c.checked = selectAll.checked; });
                    syncBulk();
                });
            }
            checks().forEach(c => c.addEventListener('change', syncBulk));
            syncBulk();
        })();
    </script>
}
