@model IEnumerable<SoftflipSolutions.Models.ChannelPartner>
@{
    ViewData["Title"] = "Channel Partners";
    Layout = "_AdminLayout";
}

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="glass-card p-0 overflow-hidden">
    <div class="p-4 border-bottom d-flex justify-content-between align-items-center flex-wrap gap-3 admin-table-header" style="border-color: rgba(255,255,255,0.08) !important;">
        <div>
            <h5 class="mb-1">Channel Partners</h5>
            <p class="mb-0 small text-muted">Create partners — they auto-list on the website and get a login panel</p>
        </div>
        <div class="d-flex align-items-center gap-3">
            <span class="badge bg-primary bg-opacity-25 text-info border border-primary border-opacity-50 px-3 py-2 rounded-pill">Total: @Model.Count()</span>
            <a asp-action="AddChannelPartner" class="btn btn-sm btn-info rounded-pill px-3 fw-semibold">
                <i class="bi bi-plus-lg me-1"></i> Add Partner
            </a>
        </div>
    </div>
    <div class="table-responsive">
        <table class="table table-borderless mb-0 align-middle">
            <thead>
                <tr>
                    <th>Company</th>
                    <th>Owner</th>
                    <th>Contact</th>
                    <th>Location</th>
                    <th>Clients</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var p in Model)
                {
                    <tr>
                        <td>
                            <div class="d-flex align-items-center gap-2">
                                @if (!string.IsNullOrWhiteSpace(p.LogoPath))
                                {
                                    <img src="@p.LogoPath" alt="" style="width:36px;height:36px;object-fit:contain;border-radius:8px;background:#fff;padding:2px;" />
                                }
                                <div>
                                    <div class="fw-bold">@p.CompanyName</div>
                                    <div class="small text-muted">@p.CreatedAt.ToString("dd MMM yyyy")</div>
                                </div>
                            </div>
                        </td>
                        <td>@p.OwnerName</td>
                        <td>
                            <div class="small">@p.Mobile</div>
                            <div class="small text-muted">@p.Email</div>
                        </td>
                        <td class="small">@p.LocationLabel</td>
                        <td><span class="badge bg-info bg-opacity-25 text-info">@(p.Clients?.Count ?? 0)</span></td>
                        <td>
                            @if (p.IsActive)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success">Active / Listed</span>
                            }
                            else
                            {
                                <span class="badge bg-secondary">Inactive</span>
                            }
                        </td>
                        <td class="text-end">
                            <div class="admin-row-actions">
                                <a asp-action="ChannelPartnerDetails" asp-route-id="@p.Id" class="btn btn-icon-action" title="View">
                                    <i class="bi bi-eye"></i>
                                </a>
                                <a asp-action="EditChannelPartner" asp-route-id="@p.Id" class="btn btn-icon-action edit" title="Edit">
                                    <i class="bi bi-pencil-square"></i>
                                </a>
                                <button type="button"
                                        class="btn btn-icon-action danger"
                                        title="Delete"
                                        data-bs-toggle="modal"
                                        data-bs-target="#deletePartnerModal"
                                        data-partner-id="@p.Id"
                                        data-partner-name="@p.CompanyName">
                                    <i class="bi bi-trash3"></i>
                                </button>
                            </div>
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="7" class="text-center py-5 text-muted">
                            <i class="bi bi-shop fs-1 d-block mb-2"></i>
                            No channel partners yet. Add your first partner.
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

<div class="modal fade" id="deletePartnerModal" tabindex="-1" aria-labelledby="deletePartnerModalLabel" aria-hidden="true">
    <div class="modal-dialog modal-dialog-centered">
        <div class="modal-content admin-confirm-modal">
            <div class="modal-header border-0 pb-0">
                <div class="admin-confirm-ico"><i class="bi bi-trash3"></i></div>
                <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
            </div>
            <div class="modal-body pt-2">
                <h5 class="modal-title mb-2" id="deletePartnerModalLabel">Delete channel partner?</h5>
                <p class="mb-0 text-muted">
                    This will permanently remove <strong id="deletePartnerName">this partner</strong>, their clients, and proposals. This cannot be undone.
                </p>
            </div>
            <div class="modal-footer border-0">
                <button type="button" class="btn btn-lead-back" data-bs-dismiss="modal">Cancel</button>
                <form asp-action="DeleteChannelPartner" method="post" id="deletePartnerForm">
                    @Html.AntiForgeryToken()
                    <input type="hidden" name="id" id="deletePartnerId" value="" />
                    <button type="submit" class="btn btn-danger"><i class="bi bi-trash3 me-1"></i> Delete</button>
                </form>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <script>
        (function () {
            const modal = document.getElementById('deletePartnerModal');
            if (!modal) return;
            modal.addEventListener('show.bs.modal', function (event) {
                const btn = event.relatedTarget;
                if (!btn) return;
                document.getElementById('deletePartnerId').value = btn.getAttribute('data-partner-id') || '';
                document.getElementById('deletePartnerName').textContent = btn.getAttribute('data-partner-name') || 'this partner';
            });
        })();
    </script>
}
