@model SoftflipSolutions.Models.ChannelPartner
@{
    ViewData["Title"] = "Add Channel Partner";
    Layout = "_AdminLayout";
}

<div class="glass-card p-4">
    <div class="mb-4">
        <a asp-action="ChannelPartners" class="btn btn-lead-back mb-3"><i class="bi bi-arrow-left"></i> Back</a>
        <h4 class="text-white mb-1">Add Channel Partner</h4>
        <p class="text-muted small mb-0">Partner will get panel login and appear on the public Partners page.</p>
    </div>

    <div asp-validation-summary="ModelOnly" class="alert alert-danger"></div>

    <form asp-action="AddChannelPartner" method="post" enctype="multipart/form-data">
        @Html.AntiForgeryToken()
        <div class="row g-3">
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="CompanyName"></label>
                <input asp-for="CompanyName" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="OwnerName"></label>
                <input asp-for="OwnerName" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="Gstin"></label>
                <input asp-for="Gstin" class="form-control settings-input" placeholder="Optional" />
            </div>
            <div class="col-12">
                @{
                    ViewData["UploadInputName"] = "logoFile";
                    ViewData["UploadLabel"] = "Company logo";
                    ViewData["UploadHint"] = "PNG, JPG or WEBP · max 2 MB · shown on website & proposals";
                    ViewData["UploadCurrentUrl"] = null;
                    ViewData["UploadRemoveName"] = null;
                    ViewData["UploadVariant"] = "logo";
                }
                <partial name="_ImageUpload" />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="Mobile"></label>
                <input asp-for="Mobile" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="Email"></label>
                <input asp-for="Email" type="email" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label" asp-for="Website"></label>
                <input asp-for="Website" type="text" class="form-control settings-input" placeholder="www.yourcompany.com" />
            </div>
            <div class="col-12">
                <label class="lead-info-label" asp-for="Address"></label>
                <textarea asp-for="Address" class="form-control settings-input" rows="2" required></textarea>
            </div>
            <div class="col-md-4">
                <label class="lead-info-label" asp-for="City"></label>
                <input asp-for="City" class="form-control settings-input" required />
            </div>
            <div class="col-md-4">
                <label class="lead-info-label" asp-for="State"></label>
                <input asp-for="State" class="form-control settings-input" required />
            </div>
            <div class="col-md-4">
                <label class="lead-info-label" asp-for="Pincode"></label>
                <input asp-for="Pincode" class="form-control settings-input" required />
            </div>
            <div class="col-md-6">
                <label class="lead-info-label">Login password</label>
                <input type="text" name="password" class="form-control settings-input" required minlength="4" placeholder="Partner panel password" />
                <div class="form-text text-muted">Partner logs in at /Partner/Login with email + this password.</div>
            </div>
        </div>
        <div class="mt-4">
            <button type="submit" class="btn btn-crm-primary"><i class="bi bi-check2-circle me-1"></i> Create Partner</button>
        </div>
    </form>
</div>
