@model IEnumerable<SoftflipSolutions.ViewModels.FollowUpReminderItem>
@{
    ViewData["Title"] = "Follow-ups";
    Layout = "_AdminLayout";
    var showDone = string.Equals(Context.Request.Query["show"], "done", StringComparison.OrdinalIgnoreCase);
    var overdue = Model.Count(x => x.IsOverdue);
}

<div class="page-toolbar">
    <h2>Follow-ups</h2>
    <div class="toolbar-actions">
        @if (showDone)
        {
            <a asp-action="FollowUps" class="btn btn-sm btn-crm-outline rounded-pill px-3">Open only</a>
        }
        else
        {
            <a asp-action="FollowUps" asp-route-show="done" class="btn btn-sm btn-crm-outline rounded-pill px-3">Include done</a>
        }
    </div>
</div>

@if (TempData["SuccessMessage"] != null)
{
    <div class="alert alert-success alert-dismissible fade show" role="alert">
        <i class="bi bi-check-circle-fill me-2"></i> @TempData["SuccessMessage"]
        <button type="button" class="btn-close" data-bs-dismiss="alert"></button>
    </div>
}

<div class="row g-3 mb-4">
    <div class="col-sm-4">
        <div class="stat-card accent-yellow">
            <div class="stat-card-top">
                <div class="stat-label">Overdue</div>
                <div class="stat-icon warning"><i class="bi bi-alarm"></i></div>
            </div>
            <div class="stat-value">@overdue</div>
        </div>
    </div>
    <div class="col-sm-4">
        <div class="stat-card accent-blue">
            <div class="stat-card-top">
                <div class="stat-label">Listed</div>
                <div class="stat-icon info"><i class="bi bi-list-check"></i></div>
            </div>
            <div class="stat-value">@Model.Count()</div>
        </div>
    </div>
</div>

<div class="glass-card p-0 overflow-hidden">
    <div class="p-4 border-bottom admin-table-header" style="border-color: rgba(255,255,255,0.08) !important;">
        <h5 class="mb-1">Reminders</h5>
        <p class="mb-0 small text-muted">Add follow-ups from any lead detail page</p>
    </div>
    <div class="table-responsive">
        <table class="table table-borderless mb-0 align-middle">
            <thead>
                <tr>
                    <th>Due</th>
                    <th>Lead</th>
                    <th>Note</th>
                    <th>Status</th>
                    <th class="text-end">Action</th>
                </tr>
            </thead>
            <tbody>
                @foreach (var item in Model)
                {
                    <tr>
                        <td class="@(item.IsOverdue ? "text-warning fw-semibold" : "")">
                            @item.DueAt.ToString("dd MMM yyyy")
                            @if (item.IsOverdue)
                            {
                                <span class="badge bg-warning text-dark ms-1">Overdue</span>
                            }
                        </td>
                        <td>
                            <a href="@LeadDetailUrl(item.LeadType, item.LeadId)" class="text-decoration-none fw-semibold">@item.LeadName</a>
                            <div class="small text-muted">@item.LeadType</div>
                        </td>
                        <td>@item.Note</td>
                        <td>
                            @if (item.IsDone)
                            {
                                <span class="badge bg-success bg-opacity-25 text-success">Done</span>
                            }
                            else
                            {
                                <span class="badge bg-info bg-opacity-25 text-info">Open</span>
                            }
                        </td>
                        <td class="text-end">
                            <a href="@LeadDetailUrl(item.LeadType, item.LeadId)" class="btn btn-icon-action" title="Open"><i class="bi bi-eye"></i></a>
                            @if (!item.IsDone)
                            {
                                <form asp-action="CompleteFollowUp" method="post" class="d-inline">
                                    @Html.AntiForgeryToken()
                                    <input type="hidden" name="id" value="@item.Id" />
                                    <button type="submit" class="btn btn-sm btn-outline-success">Done</button>
                                </form>
                            }
                        </td>
                    </tr>
                }
                @if (!Model.Any())
                {
                    <tr>
                        <td colspan="5" class="text-center py-5 text-muted">
                            <i class="bi bi-alarm fs-1 d-block mb-2"></i>
                            No follow-ups@(showDone ? "" : " open").
                        </td>
                    </tr>
                }
            </tbody>
        </table>
    </div>
</div>

@functions {
    string LeadDetailUrl(string leadType, int leadId) => leadType switch
    {
        SoftflipSolutions.Models.LeadPipeline.LeadClient => Url.Action("ClientLeadDetails", "Admin", new { id = leadId })!,
        SoftflipSolutions.Models.LeadPipeline.LeadDemo => Url.Action("DemoRequestDetails", "Admin", new { id = leadId })!,
        _ => Url.Action("EnquiryDetails", "Admin", new { id = leadId })!
    };
}
